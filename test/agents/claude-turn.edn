;; A turn of Claude Code's stream-json, for tools/stand-in.skn (agents-test): the
;; initialize handshake, a message replayed, streamed text, a tool use asked about and
;; allowed, the IDE's tools listed and one called, a rate limit, the result, and the
;; context's usage.
[[:expect {"type" "control_request" "request.subtype" "initialize"}]
 [:send {"type" "control_response"
         "response" {"subtype" "success" "request_id" "$last.request_id"
                     "response" {"models" [{"value" "default" "resolvedModel" "claude-opus-5-5"}
                                           {"value" "opus" "displayName" "Opus"
                                            "resolvedModel" "claude-opus-5-5"
                                            "supportsEffort" true
                                            "supportedEffortLevels" ["low" "high"]}
                                           {"value" "sonnet" "displayName" "Sonnet"
                                            "resolvedModel" "claude-sonnet-5-5"}]}}}]
 [:send {"type" "system" "subtype" "init" "session_id" "s-1"}]
 [:expect {"type" "user" "message.content" "hi"}]
 [:send {"type" "user" "isReplay" true "uuid" "$last.uuid"}]
 [:send {"type" "control_request" "request_id" "mcp-0"
         "request" {"subtype" "mcp_message"
                    "message" {"jsonrpc" "2.0" "id" 1 "method" "tools/list"}}}]
 [:expect {"type" "control_response" "response.request_id" "mcp-0"}]
 [:send {"type" "stream_event" "event" {"type" "message_start" "message" {"id" "m1"}}}]
 [:send {"type" "stream_event"
         "event" {"type" "content_block_start" "index" 0 "content_block" {"type" "text"}}}]
 [:send {"type" "stream_event"
         "event" {"type" "content_block_delta" "index" 0
                  "delta" {"type" "text_delta" "text" "Hel"}}}]
 [:send {"type" "stream_event"
         "event" {"type" "content_block_delta" "index" 0
                  "delta" {"type" "text_delta" "text" "lo"}}}]
 [:send {"type" "assistant"
         "message" {"id" "m1"
                    "content" [{"type" "text" "text" "Hello"}
                               {"type" "tool_use" "id" "t1" "name" "Bash"
                                "input" {"command" "ls"}}]}}]
 [:send {"type" "control_request" "request_id" "perm-1"
         "request" {"subtype" "can_use_tool" "tool_name" "Bash" "input" {"command" "ls"}}}]
 [:expect {"type" "control_response" "response.request_id" "perm-1"
           "response.response.behavior" "allow"}]
 [:send {"type" "user"
         "message" {"content" [{"type" "tool_result" "tool_use_id" "t1" "content" "a.txt"}]}}]
 [:send {"type" "control_request" "request_id" "mcp-1"
         "request" {"subtype" "mcp_message"
                    "message" {"jsonrpc" "2.0" "id" 7 "method" "tools/call"
                               "params" {"name" "ide_problems" "arguments" {"file" "a.skn"}}}}}]
 [:expect {"type" "control_response" "response.request_id" "mcp-1"
           "response.response.mcp_response.id" 7
           "response.response.mcp_response.result.isError" false}]
 [:send {"type" "rate_limit_event"
         "rate_limit_info" {"unifiedWindows" {"five_hour" {"utilization" 0.25 "status" "allowed"
                                                            "resetsAt" 1800000000}}}}]
 [:send {"type" "result" "session_id" "s-1" "is_error" false}]
 [:expect {"type" "control_request" "request.subtype" "get_context_usage"}]
 [:send {"type" "control_response"
         "response" {"subtype" "success" "request_id" "$last.request_id"
                     "response" {"totalTokens" 1200 "maxTokens" 200000}}}]]
