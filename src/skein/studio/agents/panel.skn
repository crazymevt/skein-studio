(ns skein.studio.agents.panel
  "The agent panel (Skein's M3.8 step 4, D-110; drawn as Xeon Studio's chat in M3.9 step
4, D-115): Claude Code and Codex at its top as chips, with their model, effort and
autonomy; the conversation as a column of rows, each a widget of its own (your messages in
a bubble, an agent's replies streaming in as Markdown under its avatar, its tools as cards
that open on their output, notices as a line); approvals and questions as cards over the
composer; and the composer, a rounded box with the context as chips, the usage limits as
badges and Send, which sends the message (with the open file and the selection as
context, and attached files) or, while a turn runs, adds it to the turn. It sits on the
right of the editors (View ▸ Agent, Primary+J); install! puts it in a workbench.

The adapters' events come on their fibers and are handed to the UI's thread, where
everything here runs."
  (:require [skein.ui :as ui]
            [skein.io :as io]
            [skein.string :as string]
            [skein.system :as system]
            [skein.markdown :as md]
            [skein.studio.settings :as settings]
            [skein.studio.workbench :as wb]
            [skein.studio.repl :as repl]
            [skein.studio.debugger :as debugger]
            [skein.studio.agents :as agents]
            [skein.studio.agents.claude :as claude]
            [skein.studio.agents.codex :as codex]
            [skein.studio.agents.tools :as tools]
            [skein.studio.icons :as icons]
            [skein.time :as time]))

(def agent-ids "The agents, in the order they're offered." ["claude" "codex"])


(defn agent-label [id] (if (= id "codex") "Codex" "Claude"))

(def ^:private autonomies [[:auto "Auto"] [:ask "Ask first"] [:read-only "Read only"]])

;;; The composer: Return sends, Shift+Return starts a new line.

(defclass composer-view [ui/code-view-widget]
  "The message being written: Return sends it (on-send), Shift+Return starts a new line."
  (on-send :cell :atom :init nil))

(defmethod ui/measure [(v composer-view)]
  ;; a code view measures 200 tall; the composer is a few lines, the chat gets the rest
  [300 48])

(defmethod ui/handle-event :around [(v composer-view) (e ui/key-event)]
  (if (and (= :key-down (:signal e)) (not (ui/consumed? e)) (= :return (:key e))
           (empty? (:modifiers e)) (:on-send v))
    (do ((:on-send v)) (ui/consume! e))
    (call-next-method)))

;;; State

(defn- st [p] @(:state p))

(defn- choice
  "The model or effort (k) chosen for agent id, or nil for the CLI's own."
  [id k]
  (get-in (settings/setting :agent-choices) [id k]))

(defn- set-choice! [id k v]
  (settings/set-setting! :agent-choices
                         (assoc-in (settings/setting :agent-choices) [id k]
                                   (when-not (string/blank? (str v)) v))))

(defn- session-key [p] (or (wb/folder (:w p)) "~"))

(defn- saved-session
  "The conversation agent id last had in this folder, to resume."
  [p id]
  (get-in (settings/setting :agent-sessions) [(session-key p) id]))

(defn- save-session-id! [p id session]
  (settings/set-setting! :agent-sessions
                         (assoc-in (or (settings/setting :agent-sessions) {})
                                   [(session-key p) id] session)))

;;; The chat: entries rendered as rich text.

(defn- user-blocks [{:keys [text context files]}]
  (concat [[:p [:b "You"]]]
          (map (fn [para] [:p para]) (remove string/blank? (string/split text #"\n\s*\n")))
          (when (or (seq context) (seq files))
            [[:p [:i (string/join ", " (concat context (map io/file-name files)))]]])))

(defn- activity-blocks [{:keys [label detail output state]}]
  (let [mark (case state :done " ✓" :failed " ✗" " …")]
    (concat [[:p "▸ " [:b (str label)] (when (seq detail) " ") (when (seq detail) [:code detail])
              mark]]
            (when (and (= state :failed) (seq output))
              [[:pre (string/join "\n" (take 10 (string/split-lines output)))]]))))

(defn entry-blocks
  "The Hiccup blocks of a chat entry."
  [e]
  (case (:kind e)
    :user (user-blocks e)
    :agent [[:p [:b (agent-label (:agent e))]]]
    :reply (md/parse (:text e) {:softbreak " "})
    :activity (activity-blocks e)
    :notice [[:p [:i (str (when (:error e) "⚠ ") (:text e))]]]
    []))

(def ^:private skein-langs #{"skein" "skn" "clojure" "clj" "lisp"})

(defn- code-actions
  "A reply's blocks with links under each of its code blocks: Copy, Insert and, for
Skein's, Run in REPL; entry i's code block k is skein-studio:<action>/<i>/<k>."
  [blocks i]
  (let [k (volatile! -1)
        href (fn [action] (str "skein-studio:" action "/" i "/" @k))]
    (vec (mapcat (fn [b]
                   (if (= :pre (first b))
                     (let [lang (when (map? (second b)) (:lang (second b)))]
                       (vswap! k inc)
                       [b (into [:p [:a {:href (href "copy")} "Copy"] " · "
                                 [:a {:href (href "insert")} "Insert"]]
                                (when (contains? skein-langs lang)
                                  [" · " [:a {:href (href "run")} "Run in REPL"]]))])
                     [b]))
                 blocks))))

(defn code-block
  "The text of entry i's code block k, or nil."
  [p i k]
  (let [e (get (:entries (st p)) i)
        pres (filter (fn [b] (= :pre (first b))) (md/parse (str (:text e)) {:softbreak " "}))]
    (when-let [b (nth (vec pres) k nil)] (last b))))

(defn- blocks-of [e i]
  (let [bs (entry-blocks e)]
    (if (= :reply (:kind e)) (code-actions bs i) bs)))

(def ^:private link-activated!
  "Follow a link in a reply (defined with the panel, below).")

;;; The look: avatars, rows and cards

(def ^:private agent-colors {"claude" "#D97757" "codex" "#3E9E7A"})

(def ^:private status-colors
  {:idle :system-green :busy :system-orange :starting :system-orange :error :system-red})

(defn- clock
  "The local time now, as 10:26 AM."
  []
  (let [{:keys [hour minute]} (time/local-time)
        h (mod hour 12)]
    (format "%d:%02d %s" (if (zero? h) 12 h) minute (if (< hour 12) "AM" "PM"))))

(defn- avatar
  "A round avatar of letter on color, size points across; with status (an atom of an
agent's state, or nil), a dot at its corner showing it."
  ([letter color size] (avatar letter color size nil))
  ([letter color size status]
   (ui/canvas {:width size :height size :hexpand false :vexpand false :valign :start
               :focusable false
               :on-draw (fn [e]
                          (let [gc (:context e)
                                r (/ size 2)]
                            (ui/fill-circle! gc r r r {:color color})
                            (ui/draw-text! gc letter r r {:color :white :align :center
                                                          :valign :center
                                                          :font {:weight :bold
                                                                 :size (* size 0.45)}})
                            (when-let [s (when status @status)]
                              (ui/fill-circle! gc (- size 3.5) (- size 3.5) 4.5
                                               {:color :window-background})
                              (ui/fill-circle! gc (- size 3.5) (- size 3.5) 3
                                               {:color (get status-colors s
                                                            :secondary-text)}))))})))

(defn- dot
  "A small round dot in the color an atom holds."
  [color]
  (ui/canvas {:width 8 :height 8 :hexpand false :vexpand false :valign :center
              :focusable false
              :on-draw (fn [e] (ui/fill-circle! (:context e) 4 4 4 {:color @color}))}))

(defn- icon-view
  "An image view of the icon k, size points, in color (a template in the text's)."
  ([k size] (ui/image-view {:image (icons/icon k {:size size}) :hexpand false :vexpand false}))
  ([k size color]
   (ui/image-view {:image (icons/icon k {:size size :color color}) :hexpand false
                   :vexpand false})))

(defn- small [opts] (merge {:font {:size 11} :text-color :secondary-text} opts))

;; A wrapping label here has a :width of 120: its natural width, which a long line would
;; otherwise make the panel's, so it wraps at the width the pane gives instead.

(defn- time-label [] (ui/label (small {:text (clock) :user-data :time})))

(defn- header-line
  "A message's first line: who (in color, if given) and when."
  [who color]
  (ui/hbox {:spacing 8}
           (ui/label {:text who :font {:weight :semibold}
                      :text-color (or color :text)})
           (time-label)))

(defn- chip
  "A small rounded label with an icon: on (a tint of the accent) or off."
  [k text on opts]
  (apply ui/hbox (merge {:spacing 4 :padding [2 8] :corner-radius 6
                         :background (if on [:accent 0.15] :control-background)
                         :border-color (if on [:accent 0.5] :separator)}
                        opts)
         [(icon-view k 12) (ui/label {:text text :font {:size 11}})]))

(defn- user-row [e]
  (let [labels (concat (:context e) (map io/file-name (:files e)))]
    (ui/hbox {:spacing 10}
             (avatar "Y" :accent 26)
             (apply ui/vbox {:spacing 4 :hexpand true}
                    (header-line "You" nil)
                    (ui/hbox {}
                             (ui/vbox {:padding [8 12] :corner-radius 10 :hexpand true
                                       :background :control-background :border-color :separator}
                                      (ui/label {:text (str (:text e)) :wrap true :width 120
                                                 :selectable true})))
                    (when (seq labels)
                      [(apply ui/hbox {:spacing 6}
                              (map (fn [l] (chip :file l false {})) labels))])))))

(defn- agent-row
  "An agent's turn: its avatar, its name and the time; the body its replies and tools go
in. Returns [row body]."
  [e]
  (let [id (:agent e)
        body (ui/vbox {:spacing 8 :hexpand true}
                      (header-line (agent-label id) (get agent-colors id)))]
    [(ui/hbox {:spacing 10}
              (avatar (subs (agent-label id) 0 1) (get agent-colors id "#808080") 26)
              body)
     body]))

(defn- reply-view [p e i]
  (let [r (ui/rich-text {:fit-height true :content (blocks-of e i)
                         :on-link-activated (fn [ev] (link-activated! p (:href ev)))})]
    {:widget r :update (fn [e] (set-slot! r :content (blocks-of e i)))}))

(defn- output-lines [output]
  (let [ls (string/split-lines (str output))]
    (string/join "\n" (concat (take 40 ls) (when (> (count ls) 40) ["…"])))))

(defn- activity-view
  "A tool's card: a dot for its state, its name and detail; a click opens its output."
  [e]
  (let [color (atom :secondary-text)
        d (dot color)
        label (ui/label {:text "" :font {:weight :semibold}})
        detail (ui/label {:text "" :font {:family :monospace :size 11}
                          :text-color :secondary-text :hexpand true})
        output (ui/label {:text "" :font {:family :monospace :size 11} :wrap true :width 120
                          :selectable true :text-color :secondary-text :visible false})
        card (ui/vbox {:clickable true :padding [6 10] :spacing 6 :corner-radius 8
                       :background :control-background :border-color :separator
                       :hover-border-color :secondary-text
                       :on-clicked (fn [_] (when (seq (:text output))
                                             (set-slot! output :visible (not (:visible output)))))}
                      (ui/hbox {:spacing 8} d label detail)
                      output)
        update (fn [e]
                 (reset! color (case (:state e) :done :system-green :failed :system-red
                                     :system-orange))
                 (ui/redraw! d)
                 (set-slot! label :text (str (:label e)))
                 (set-slot! detail :text (agents/truncate (str (:detail e)) 200))
                 (set-slot! output :text (output-lines (:output e)))
                 ;; a failure shows what it said
                 (when (and (= :failed (:state e)) (seq (:output e)))
                   (set-slot! output :visible true)))]
    (update e)
    {:widget card :update update}))

(defn- rule [] (ui/vbox {:height 1 :width 24 :valign :center :background :separator}))

(defn- notice-view [e]
  (ui/hbox {:spacing 10}
           (rule)
           (ui/label (small {:text (str (:text e)) :wrap true :width 120 :hexpand true
                             :alignment :center
                             :text-color (if (:error e) :system-red :secondary-text)}))
           (rule)))

(def ^:private suggestions
  [["Explain this file" "What does the active file do?"
    "Explain what the active file does, briefly."]
   ["Find problems" "Look for bugs in the active file"
    "Review the active file for bugs, and suggest fixes."]
   ["Write tests" "Add tests for the code in the active file"
    (str "Write tests for the functions in the active file, following the project's test "
         "setup (skein.test), and run them with skein_eval.")]
   ["Try it in the REPL" "Load the active file and exercise its code"
    "Load the active file in the REPL with skein_eval and try its main functions."]])

(def ask!
  "Send text to the agent shown (defined below).")

(defn- welcome-view [p]
  (apply ui/vbox {:padding [36 12 12 12] :spacing 12}
         (ui/vbox {:background [:accent 0.15] :corner-radius 14 :width 52 :height 52
                   :halign :center}
                  (ui/image-view {:image (icons/icon :sparkle {:size 26 :color :accent})
                                  :hexpand false :vexpand false :halign :center
                                  :valign :center :margin [13 0 0 0]}))
         (ui/label {:text "Work with an agent" :alignment :center :halign :center
                    :font {:size 16 :weight :semibold}})
         (ui/label (small {:text (str "It reads and edits your files and uses the REPL, the "
                                      "debugger and the problems; what it does asks first "
                                      "as Autonomy says.")
                           :wrap true :width 120 :alignment :center :font {:size 12}}))
         (for [[title sub prompt] suggestions]
           (ui/vbox {:clickable true :padding [9 12] :spacing 2 :corner-radius 10
                     :background :control-background :border-color :separator
                     :hover-border-color :accent
                     :on-clicked (fn [_] (ask! p prompt))}
                    (ui/label {:text title :font {:weight :semibold}})
                    (ui/label (small {:text sub :wrap true :width 120}))))))

;;; The timeline: a widget per entry, made once and updated as its entry changes

(defn- clear-timeline! [p]
  (let [t (:timeline p)]
    (doseq [c (vec (:children t))]
      (ui/remove! t c)
      (ui/destroy! c))))

(defn- show-welcome! [p]
  (clear-timeline! p)
  (ui/add! (:timeline p) (welcome-view p))
  (swap! (:state p) assoc :views [] :group nil :welcome true))

(defn- add-row! [p w]
  (when (:welcome (st p))
    (clear-timeline! p)
    (swap! (:state p) assoc :welcome false))
  (ui/add! (:timeline p) w))

(defn- make-view!
  "Make entry e's widget, put it where it goes, and return its view: {:entry :update}."
  [p e i]
  (let [in-turn (fn [w]
                  ;; an agent's replies and tools go in its turn; without one, indented
                  (if-let [body (:group (st p))]
                    (ui/add! body w)
                    (add-row! p (ui/vbox {:margin [0 0 0 36]} w))))]
    (case (:kind e)
      :user (do (add-row! p (user-row e))
                (swap! (:state p) assoc :group nil)
                {:entry e :update (fn [_])})
      :agent (let [[row body] (agent-row e)]
               (add-row! p row)
               (swap! (:state p) assoc :group body)
               {:entry e :update (fn [_])})
      :reply (let [v (reply-view p e i)] (in-turn (:widget v)) (assoc v :entry e))
      :activity (let [v (activity-view e)] (in-turn (:widget v)) (assoc v :entry e))
      :notice (do (add-row! p (notice-view e))
                  (swap! (:state p) assoc :group nil)
                  {:entry e :update (fn [_])})
      {:entry e :update (fn [_])})))

(defn- refresh-thinking! [p]
  (let [{:keys [entries status active]} (st p)
        last-kind (:kind (peek entries))]
    ;; busy, and nothing of the reply yet
    (set-slot! (:thinking p) :visible
               (boolean (and (= :busy (get status active)) (= :agent last-kind))))))

(defn- scroll-to-end! [p]
  (wb/later! (:w p) 0 (fn [] (ui/scroll-to! (:scroller p) 0 100000000))))

(defn- render! [p]
  (swap! (:state p) assoc :render-pending false)
  (let [entries (:entries (st p))]
    (doseq [i (range (count entries))]
      (let [e (nth entries i)
            v (get (:views (st p)) i)]
        (cond (nil? v) (let [v (make-view! p e i)]
                         (swap! (:state p) update :views conj v))
              (not= e (:entry v)) (do ((:update v) e)
                                      (swap! (:state p) assoc-in [:views i :entry] e)))))
    (refresh-thinking! p)
    (scroll-to-end! p)))

(defn- schedule-render!
  "Render the chat soon: deltas that come close together are rendered once."
  [p]
  (when-not (:render-pending (st p))
    (swap! (:state p) assoc :render-pending true)
    (wb/later! (:w p) 0.05 (fn [] (render! p)))))

(defn- add-entry! [p e]
  (swap! (:state p) update :entries conj e)
  (schedule-render! p))

(defn- update-entry!
  "Change the entry of kind with :item item by f, adding (f nil) if there is none."
  [p kind item f]
  (swap! (:state p) update :entries
         (fn [es]
           (if-let [i (first (keep-indexed (fn [i e] (when (and (= kind (:kind e))
                                                                (= item (:item e)))
                                                       i))
                                           es))]
             (assoc es i (f (nth es i)))
             (conj es (f nil)))))
  (schedule-render! p))

(defn notice!
  "Show a line in the chat; error marks it as one."
  ([p text] (notice! p text false))
  ([p text error] (add-entry! p {:kind :notice :text text :error error})))

(defn entries
  "The chat's entries, oldest first: maps of :kind (:user, :agent, :reply, :activity or
:notice) and what each has."
  [p]
  (:entries (st p)))

(defn reply-links
  "The links in the replies, in order: [start end href] each."
  [p]
  (let [rich (fn rich [w] (if (instance? ui/rich-text-widget w)
                            [w]
                            (mapcat rich (or (:children w) []))))]
    (vec (mapcat :links (rich (:timeline p))))))

(defn chat-text
  "The chat's text, as it shows (without the times): its labels' and replies' text, one
to a line."
  [p]
  (let [texts (fn texts [w]
                (cond (:welcome (st p)) []
                      (instance? ui/rich-text-widget w) [(ui/code-text w)]
                      (instance? ui/label-widget w) (if (or (= :time (:user-data w))
                                                            (not (:visible w)))
                                                      []
                                                      [(:text w)])
                      :else (mapcat texts (or (:children w) []))))]
    (string/join "\n" (remove string/blank? (texts (:timeline p))))))

;;; The header

(defn- active [p] (:active (st p)))

(defn limits-text
  "The agent shown's usage limits as words: \"5h 75% left\"."
  [p]
  (string/join " · " (map (fn [w] (str (:label w) " "
                                       (if (:remaining w) (str (:remaining w) "% left")
                                           (or (:state w) ""))))
                          (get (:limits (st p)) (active p)))))

(defn- limit-badge [w]
  (let [r (:remaining w)
        tint (cond (nil? r) :secondary-text (> r 50) :system-green (> r 20) :system-orange
                   :else :system-red)]
    (ui/hbox {:padding [1 6] :corner-radius 5 :background [tint 0.18]
              :tooltip (str (:label w) ": " (if r (str r "% left") (or (:state w) "")))}
             (ui/label {:text (string/upper-case (str (:label w) (when r (str " " r "%"))))
                        :font {:size 10 :weight :semibold} :text-color tint}))))

(defn- refresh-chips! [p]
  (let [{:keys [status]} (st p)
        id (active p)]
    (doseq [[aid {:keys [card status-atom avatar]}] (:chips p)]
      (let [on (= aid id)]
        (set-slot! card :background (if on [:accent 0.15] nil))
        (set-slot! card :border-color (if on :accent :separator))
        (reset! status-atom (get status aid))
        (ui/redraw! avatar)))))

(defn- refresh-header! [p]
  (let [{:keys [status models limits]} (st p)
        id (active p)
        ms (get models id)
        model (choice id :model)
        efforts (or (:efforts (first (filter (fn [m] (= model (:id m))) ms)))
                    (some :efforts (filter :default ms))
                    [])
        busy (= :busy (get status id))]
    (refresh-chips! p)
    (set-slot! (:status-label p) :text (name (or (get status id) :stopped)))
    (set-slot! (:model-box p) :items (into ["Default model"] (map :label ms)))
    (set-slot! (:model-box p) :selected-index
               (or (first (keep-indexed (fn [i m] (when (= model (:id m)) (inc i))) ms)) 0))
    (set-slot! (:effort-box p) :items (into ["Default effort"] efforts))
    (set-slot! (:effort-box p) :selected-index
               (or (first (keep-indexed (fn [i e] (when (= (choice id :effort) e) (inc i)))
                                        efforts))
                   0))
    (let [box (:limits-box p)]
      (doseq [c (vec (:children box))] (ui/remove! box c) (ui/destroy! c))
      (doseq [w (get limits id)] (ui/add! box (limit-badge w))))
    (set-slot! (:stop-button p) :visible busy)
    (when (:thinking p) (refresh-thinking! p))))

;;; Requests: approvals and questions, as buttons under the chat

(defn- adapter-of [p id] (get-in (st p) [:adapters id]))

(defn- answer! [p id request decision answers]
  (when-let [a (adapter-of p id)]
    (agents/answer! a (:id request) decision answers)))

(defn- question-widget [p id request q answers]
  (let [qid (:id q)]
    (if (:multiple q)
      (apply ui/vbox {:spacing 2}
             (ui/label {:text (str (:text q))})
             (for [o (:options q)]
               (ui/check-box {:label (:label o) :tooltip (:description o)
                              :on-toggled (fn [e] (swap! answers update qid
                                                         (fn [xs] (if (:value e)
                                                                    (conj (vec xs) (:label o))
                                                                    (vec (remove #{(:label o)}
                                                                                 xs))))))})))
      (apply ui/vbox {:spacing 2}
             (ui/label {:text (str (:text q))})
             [(apply ui/hbox {:spacing 4}
                     (for [o (:options q)]
                       (ui/button {:label (:label o) :tooltip (:description o)
                                   :on-clicked (fn [_]
                                                 (swap! answers assoc qid (:label o)))})))]))))

(def ^:private request-card
  {:padding [10 12] :spacing 8 :corner-radius 10 :background [:accent 0.12]
   :border-color :accent})

(defn- request-title [id request]
  (ui/hbox {:spacing 8}
           (icon-view :problems 14 :accent)
           (ui/label {:text (str (agent-label id) ": " (:title request)) :wrap true :width 120
                      :hexpand true :font {:weight :semibold}})))

(defn- request-widget [p id request]
  (let [answers (atom {})]
    (case (:kind request)
      :question
      (apply ui/vbox request-card
             (request-title id request)
             (concat (for [q (:questions request)] (question-widget p id request q answers))
                     [(ui/hbox {}
                               (ui/button {:label "Answer"
                                           :on-clicked (fn [_]
                                                         (answer! p id request :allow
                                                                  @answers))}))]))
      (apply ui/vbox request-card
             (request-title id request)
             (concat
              (when (seq (str (:detail request)))
                [(ui/label {:text (agents/truncate (str (:detail request)) 4000)
                            :wrap true :width 120
                            :selectable true :font {:family :monospace :size 11}
                            :text-color :secondary-text})])
              [(apply ui/hbox {:spacing 6}
                      (for [o (:options request)]
                        (ui/button {:label (:label o)
                                    :on-clicked (fn [_] (answer! p id request (:value o)
                                                                 nil))})))])))))

(defn- refresh-requests! [p]
  (let [rs (:requests (st p))
        box (:requests-box p)]
    (doseq [c (:children box)]
      (ui/remove! box c)
      (ui/destroy! c))
    (doseq [[_ [id r]] (sort-by key rs)]
      (ui/add! box (request-widget p id r)))
    (set-slot! box :visible (boolean (seq rs)))))

(defn open-requests
  "The requests waiting for an answer, [agent-id request]."
  [p]
  (vec (vals (:requests (st p)))))

;;; Events

(defn- exited! [p id e]
  (let [a (adapter-of p id)]
    ;; A restart (another model) ends the old CLI once the new one runs: that one stays.
    ;; One the panel let go of (New Chat, another program) was stopped on purpose.
    (when (and a (not (agents/cli-alive? (agents/state a :cli))))
      (swap! (:state p) (fn [s] (-> s
                                    (update :adapters dissoc id)
                                    (assoc-in [:status id] :stopped))))
      (let [err (string/trim (str (:stderr e)))]
        (when (seq err)
          (wb/append-output! (:w p) (str (agent-label id) " exited (" (:code e) "):\n" err "\n")))
        (when (and (not= 0 (:code e)) (seq err))
          (notice! p (str (agent-label id) " stopped: "
                          (agents/truncate (last (string/split-lines err)) 200))
                   true)))
      (refresh-header! p))))

(defn on-event!
  "Handle an adapter's event, on the UI's thread."
  [p e]
  (let [id (:agent e)]
    (case (:type e)
      :status (do (swap! (:state p) assoc-in [:status id] (:status e))
                  (when (:message e) (notice! p (str (:message e)) true))
                  (refresh-header! p))
      :text (update-entry! p :reply (:item e)
                           (fn [x] (if x
                                     (update x :text str (:delta e))
                                     {:kind :reply :item (:item e) :agent id :text (:delta e)})))
      :message (update-entry! p :reply (:item e)
                              (fn [x] (assoc (or x {:kind :reply :item (:item e) :agent id})
                                             :text (:text e))))
      :activity (let [given (into {} (remove (fn [[_ v]] (nil? v))
                                             (select-keys e [:label :detail :output :state])))]
                  (update-entry! p :activity (:item e)
                                 (fn [x] (merge (or x {:kind :activity :item (:item e)}) given))))
      :request (let [r (:request e)]
                 (swap! (:state p) assoc-in [:requests (:id r)] [id r])
                 (refresh-requests! p)
                 (wb/show-right! (:w p))
                 (wb/message! (:w p) (str (agent-label id) " is waiting for your answer.")))
      :request-resolved (do (swap! (:state p) update :requests dissoc (:id e))
                            (refresh-requests! p)
                            (when (empty? (:requests (st p))) (wb/message! (:w p) "")))
      :tool-call (tools/run-tool! (:w p) e)
      :turn-done (when (:error e) (notice! p (str (:error e)) true))
      :models (do (swap! (:state p) assoc-in [:models id] (:models e))
                  (refresh-header! p))
      :limits (do (swap! (:state p) assoc-in [:limits id] (:windows e))
                  (refresh-header! p))
      :usage (swap! (:state p) assoc-in [:usage id] (select-keys e [:context-used :context-window]))
      :session (save-session-id! p id (:id e))
      :reset (save-session-id! p id nil)
      :notice (notice! p (str (:text e)))
      :exited (exited! p id e)
      nil)))

;;; Agents

(defn- ensure-agent!
  "Agent id's adapter, started now if it wasn't; nil if its CLI isn't installed."
  [p id]
  (or (adapter-of p id)
      (let [program (get-in (st p) [:programs id])
            provider (keyword id)]
        (if-not (or program (agents/find-cli provider))
          (do (notice! p (str "The " id " CLI isn't installed: install it and sign in, then "
                              "try again.")
                       true)
              nil)
          (let [make (if (= id "codex") codex/adapter claude/adapter)
                a (make {:name id :folder (or (wb/folder (:w p)) (system/home-dir))
                         :program program :tools tools/tools :instructions tools/instructions
                         :autonomy (settings/setting :agent-autonomy)
                         :model (choice id :model) :effort (choice id :effort)
                         :session-id (saved-session p id)
                         :session-tools (when (saved-session p id)
                                          (agents/tools-version tools/tools))
                         :sink (fn [e] (wb/later! (:w p) 0 (fn [] (on-event! p e))))})]
            (swap! (:state p) assoc-in [:adapters id] a)
            (try (agents/start! a) a
                 (catch error e
                   (swap! (:state p) update :adapters dissoc id)
                   (notice! p (str "Couldn't start " (agent-label id) ": "
                                   (or (ex-message e) e))
                            true)
                   nil)))))))

(defn- restart-agent! [p id]
  (when-let [a (adapter-of p id)]
    (agents/stop! a)
    (agents/start! a)))

(defn use-program!
  "Run program (a path, or a program and its first arguments) as agent id's CLI from its
next start, stopping the one running: a stand-in, say."
  [p id program]
  (when-let [a (adapter-of p id)]
    (agents/stop! a)
    (swap! (:state p) update :adapters dissoc id))
  (swap! (:state p) assoc-in [:programs id] program))

(defn agent-status
  "The state of the agent shown: :starting, :idle, :busy, :error, :stopped."
  [p]
  (or (get-in (st p) [:status (active p)]) :stopped))

(defn click!
  "Click the panel's button labelled label (Send, Stop, or one of a request's), as the
user would; false if there is none."
  [p label]
  (let [buttons (fn buttons [w] (concat (when (or (instance? ui/button-widget w)
                                                   (and (instance? ui/container-widget w)
                                                        (:clickable w)))
                                           [w])
                                         (mapcat buttons (or (:children w) []))))
        named (fn [b] (or (:label b) (:label (:user-data b))))]
    (if-let [b (first (filter (fn [b] (and (:visible b) (= label (named b))))
                              (buttons (:widget p))))]
      (do (ui/emit! b (ui/event-for b :clicked)) true)
      false)))

(defn select-agent!
  "Show agent id (\"claude\" or \"codex\") and start it."
  [p id]
  (swap! (:state p) assoc :active id)
  (settings/set-setting! :agent id)
  (refresh-header! p)
  (ensure-agent! p id))

(defn- model-chosen! [p i]
  (let [id (active p)
        ms (get-in (st p) [:models id])
        model (when (pos? i) (:id (nth ms (dec i) nil)))]
    (when (not= model (choice id :model))
      (set-choice! id :model model)
      (set-choice! id :effort nil)
      (refresh-header! p)
      (when-let [a (adapter-of p id)]
        (when (= :restart (agents/choose-model! a model nil))
          (restart-agent! p id)
          (notice! p (str (agent-label id) " restarted with "
                          (or (:label (first (filter (fn [m] (= model (:id m))) ms)))
                              "its default model")
                          "; the conversation goes on.")))))))

(defn- effort-chosen! [p i]
  (let [id (active p)
        effort (when (pos? i) (nth (:items (:effort-box p)) i nil))]
    (when (not= effort (choice id :effort))
      (set-choice! id :effort effort)
      (when-let [a (adapter-of p id)]
        (when (= :restart (agents/choose-model! a (choice id :model) effort))
          (restart-agent! p id))))))

(defn set-autonomy!
  "Use autonomy (:auto, :ask or :read-only) from each agent's next start."
  [p autonomy]
  (settings/set-setting! :agent-autonomy autonomy)
  (doseq [[_ a] (:adapters (st p))] (agents/set-autonomy! a autonomy))
  (notice! p (str "Autonomy: " (second (first (filter (fn [[k _]] (= k autonomy)) autonomies)))
                  ", from the next conversation")))

(defn new-chat!
  "Stop the agents and forget their conversations: the next message starts a new one."
  [p]
  (doseq [[id a] (:adapters (st p))]
    (agents/stop! a)
    (agents/reset-conversation! a)
    (save-session-id! p id nil))
  (swap! (:state p) assoc :adapters {} :status {} :entries [] :requests {})
  (refresh-requests! p)
  (refresh-header! p)
  (show-welcome! p))

;;; Sending

(defn- refresh-chips-row!
  "The composer's chips: the open file and the selection (a click leaves either out of
the message, or puts it back), and the attached files (a click takes one off)."
  [p]
  (let [row (:chips-row p)
        {:keys [include-file include-selection attachments]} (st p)
        toggle (fn [k] (fn [_] (swap! (:state p) update k not) (refresh-chips-row! p)))]
    (doseq [c (vec (:children row))] (ui/remove! row c) (ui/destroy! c))
    (ui/add! row (chip :file "Open file" include-file
                       {:clickable true :tooltip "Send where you are in the open file"
                        :on-clicked (toggle :include-file)}))
    (ui/add! row (chip :code "Selection" include-selection
                       {:clickable true :tooltip "Send the selected text"
                        :on-clicked (toggle :include-selection)}))
    (doseq [f attachments]
      (ui/add! row (chip :close (io/file-name f) false
                         {:clickable true :tooltip (str f " (click to take it off)")
                          :on-clicked (fn [_]
                                        (swap! (:state p) update :attachments
                                               (fn [xs] (vec (remove #{f} xs))))
                                        (refresh-chips-row! p))})))))

(defn context
  "What the message says of where the user is, and its labels for the chat:
[text labels], text nil when there is nothing to say."
  [p include-file include-selection]
  (let [w (:w p)]
    (if-let [ed (wb/active-editor w)]
      (let [v (:view ed)
            path (:path (:document ed))
            rel (let [f (wb/folder w)]
                  (if (and f (string/starts-with? path (str f "/")))
                    (subs path (inc (count f)))
                    path))
            line (inc (ui/position-line (:buffer v) (:cursor v)))
            selected (ui/selected-text v)
            form (when (and include-file (= "skn" (io/extension path)))
                   (when-let [[s e] (wb/form-at-caret w)]
                     (when (< (- e s) 6000) (ui/buffer-text (:buffer v) s e))))
            parts (concat
                   (when include-file
                     [(str "The user is looking at " rel ", line " line
                           (when-let [ns (wb/file-ns ed)] (str ", in namespace " ns)) ".")])
                   (when form
                     [(str "The top-level form at the caret:\n```skein\n" form "\n```")])
                   (when (and include-selection (seq selected))
                     [(str "Selected text:\n```\n" (agents/truncate selected 12000) "\n```")]))
            labels (concat (when include-file [rel])
                           (when (and include-selection (seq selected))
                             [(str (count selected) " characters selected")]))]
        [(when (seq parts) (string/join "\n\n" parts)) (vec labels)])
      [nil []])))

(defn- attachments-text [files images]
  (str "The user attached " (if (next files) "these files" "this file") ":\n"
       (string/join "\n" (for [f files]
                           (str "- " f
                                (cond (some #{f} images) " (an image, included in this message)"
                                      (agents/image-media-type f)
                                      " (an image too large to include: open it with your tools)"
                                      :else ""))))))

(defn send!
  "Send text (by default the composer's) to the agent shown: as a new turn, or added to
the turn under way."
  ([p] (send! p (ui/code-text (:composer p))))
  ([p text]
   (let [files (:attachments (st p))]
     (when (or (not (string/blank? text)) (seq files))
       (let [id (active p)]
         (when-let [a (ensure-agent! p id)]
           (let [[ctx labels] (context p (:include-file (st p)) (:include-selection (st p)))
                 images (agents/sendable-images files)
                 message (str (if (and (string/blank? text) (seq files))
                                "See the attached files."
                                text)
                              (when (seq files) (str "\n\n" (attachments-text files images)))
                              (when ctx (str "\n\n---\n" ctx)))]
             (add-entry! p {:kind :user :text text :context labels :files files})
             (add-entry! p {:kind :agent :agent id})
             (swap! (:state p) assoc :attachments [])
             (refresh-chips-row! p)
             (ui/set-buffer-text! (:buffer (:composer p)) "")
             (if (= :busy (get-in (st p) [:status id]))
               (agents/steer! a message images)
               (agents/send! a message images)))))))))

(defn attachments
  "The files attached to the next message."
  [p]
  (:attachments (st p)))

(defn attach!
  "Attach files (paths) to the next message."
  [p files]
  (swap! (:state p) update :attachments (fn [xs] (vec (distinct (concat xs files)))))
  (refresh-chips-row! p))

(defn stop!
  "Stop the turn under way."
  [p]
  (when-let [a (adapter-of p (active p))] (agents/interrupt! a)))

(defn stop-agents!
  "End every agent's CLI."
  [p]
  (doseq [[_ a] (:adapters (st p))] (agents/stop! a)))

;;; The panel

(defn code-action!
  "Copy entry i's code block k, insert it at the active editor's caret, or run it in the
REPL (action \"copy\", \"insert\" or \"run\")."
  [p action i k]
  (let [w (:w p)]
    (when-let [code (code-block p i k)]
      (case action
        "copy" (do (ui/set-clipboard-text! code) (wb/message! w "Copied"))
        "insert" (if-let [ed (wb/active-editor w)]
                   (do (ui/replace-selection! (:view ed) code)
                       (ui/focus! (:view ed)))
                   (wb/message! w "No editor to insert into"))
        "run" (let [r (:repl w)]
                (ui/set-buffer-text! (:buffer (:input r)) (string/trim code))
                (repl/send! r)
                (wb/show-panel! w (:widget r)))
        nil))))

(defn- open-link! [p href]
  (let [w (:w p)
        path (when-not (re-find #"^[a-z][a-z0-9+.-]*:" href)
               (if (or (io/absolute? href) (nil? (wb/folder w)))
                 href
                 (io/path (wb/folder w) href)))]
    (if (and path (io/file? path))
      (wb/open-file! w path)
      (system/open! href))))

(defn- link-activated! [p href]
  (if-let [[_ action i k] (re-find #"^skein-studio:(\w+)/(\d+)/(\d+)$" href)]
    (code-action! p action (parse-long i) (parse-long k))
    (open-link! p href)))

(defn- agent-chip [p-ref id]
  (let [status (atom nil)
        a (avatar (subs (agent-label id) 0 1) (get agent-colors id) 20 status)
        card (ui/hbox {:clickable true :spacing 6 :padding [3 10 3 4] :corner-radius 14
                       :border-color :separator :hover-border-color :accent
                       :user-data {:label (agent-label id)}
                       :on-clicked (fn [_] (when-let [p @p-ref] (select-agent! p id)))}
                      a (ui/label {:text (agent-label id) :valign :center}))]
    {:card card :status-atom status :avatar a}))

(defn- send-pill [on-click]
  (ui/hbox {:clickable true :spacing 6 :padding [5 12] :corner-radius 8 :background :accent
            :hover-background [:accent 0.8] :user-data {:label "Send"} :on-clicked on-click}
           (icon-view :send 14 :white)
           (ui/label {:text "Send" :text-color :white :font {:weight :semibold}})))

(defn make-panel
  "The agent panel of the workbench w. opts: :programs, {agent-id program}, for CLIs other
than the installed ones (tests give stand-ins)."
  ([w] (make-panel w {}))
  ([w opts]
   (let [p-ref (atom nil)
         later (fn [f] (fn [e] (when-let [p @p-ref] (f p e))))
         chips (into {} (map (fn [id] [id (agent-chip p-ref id)]) agent-ids))
         status-label (ui/label (small {:text "stopped" :valign :center}))
         new-chat (ui/button {:image (icons/icon :plus) :style :icon :tooltip "New chat"
                              :on-clicked (later (fn [p _] (new-chat! p)))})
         combo (fn [o] (ui/combo-box (merge {:control-size :small :hexpand true} o)))
         model-box (combo {:items ["Default model"] :selected-index 0
                           :on-changed (later (fn [p e] (when-let [i (:index e)]
                                                          (model-chosen! p i))))})
         effort-box (combo {:items ["Default effort"] :selected-index 0
                            :on-changed (later (fn [p e] (when-let [i (:index e)]
                                                           (effort-chosen! p i))))})
         autonomy-box (combo
                       {:items (mapv second autonomies)
                        :tooltip "What the agent may do without asking"
                        :selected-index (or (first (keep-indexed
                                                    (fn [i [k _]]
                                                      (when (= k (settings/setting :agent-autonomy))
                                                        i))
                                                    autonomies))
                                            0)
                        :on-changed (later (fn [p e]
                                             (when-let [i (:index e)]
                                               (set-autonomy! p (first (nth autonomies i))))))})
         header (apply ui/vbox {:padding [8 10] :spacing 7}
                       [(apply ui/hbox {:spacing 6}
                               (concat [(icon-view :sparkle 16 :accent)]
                                       (map (fn [id] (:card (get chips id))) agent-ids)
                                       [(ui/box {:hexpand true}) status-label new-chat]))
                        (ui/hbox {:spacing 6} model-box effort-box autonomy-box)])
         timeline (ui/vbox {:padding [14 14 6 14] :spacing 16})
         thinking (ui/label (small {:text "Thinking…" :margin [0 0 8 50] :visible false}))
         scroller (ui/scrolled-window {:horizontal-policy :never :vexpand true}
                                      (ui/vbox {:spacing 0} timeline thinking))
         requests-box (ui/vbox {:spacing 8 :padding [0 12 8 12] :visible false})
         chips-row (ui/hbox {:spacing 6})
         choose (fn [p _]
                  (when-let [fs (ui/choose-file {:title "Attach Files" :multiple true
                                                 :parent (:window w) :directory (wb/folder w)})]
                    (attach! p (if (string? fs) [fs] fs))))
         attach (ui/button {:image (icons/icon :plus) :style :icon :tooltip "Attach files…"
                            :on-clicked (later choose)})
         composer (ui/build composer-view {:vexpand false :wrap true :line-numbers false
                                           :palette {:background :control-background}
                                           :font {:family :system :size 13}
                                           :placeholder (str "Ask the agent… (it can run "
                                                             "code in your REPL)")}
                            nil)
         limits-box (ui/hbox {:spacing 4 :valign :center})
         send-button (send-pill (later (fn [p _] (send! p))))
         stop-button (ui/button {:image (icons/icon :stop) :style :icon :tooltip "Stop the turn"
                                 :visible false :on-clicked (later (fn [p _] (stop! p)))})
         box (ui/vbox {:padding [8 6 6 6] :spacing 4 :corner-radius 12
                       :background :control-background :border-color :separator}
                      (ui/hbox {:padding [0 6]} chips-row)
                      composer
                      (ui/hbox {:spacing 6 :padding [0 4 0 8]}
                               (ui/label (small {:text "Return sends · Shift+Return, a new line"
                                                 :hexpand true :valign :center}))
                               limits-box attach stop-button send-button))
         widget (ui/vbox {:spacing 0 :vexpand true}
                  header
                  (ui/separator {})
                  scroller
                  requests-box
                  (ui/vbox {:padding [4 12 12 12]} box))
         id (let [s (settings/setting :agent)] (if (some #{s} agent-ids) s "claude"))
         p {:w w :widget widget :timeline timeline :thinking thinking :scroller scroller
            :composer composer :chips chips :status-label status-label :model-box model-box
            :effort-box effort-box :autonomy-box autonomy-box :limits-box limits-box
            :requests-box requests-box :chips-row chips-row
            :send-button send-button :stop-button stop-button
            :state (atom {:active id :adapters {} :status {} :models {} :limits {} :usage {}
                          :entries [] :views [] :requests {} :attachments []
                          :include-file true :include-selection true
                          :programs (or (:programs opts) {})})}]
     (reset! p-ref p)
     (set-slot! composer :on-send (fn [] (send! p)))
     (show-welcome! p)
     (refresh-chips-row! p)
     (refresh-header! p)
     p)))

(defn toggle!
  "Show the agent panel, starting its agent, or hide it."
  [p]
  (let [w (:w p)
        shown (not (wb/right-shown? w))]
    (wb/show-right! w shown)
    (when shown
      (ensure-agent! p (active p))
      (ui/focus! (:composer p)))))

(def prompts
  "What the editor's Agent commands ask: the open file and the selection go with them."
  {:explain (str "Explain the selected code (or the form at the caret): what it does, and "
                 "anything surprising.")
   :improve (str "Suggest and make improvements to the selected code (or the form at the "
                 "caret): clarity, idiomatic Skein, edge cases. Keep the behavior.")
   :write-tests (str "Write tests for the function at the caret, following the project's "
                     "test setup (skein.test), and run them with skein_eval.")
   :fix-problems (str "Fix the problems reported in the current file. Use ide_problems to "
                      "see them, then check the fix with skein_eval where it applies.")})

(defn ask!
  "Show the panel and send text to the agent shown, with the open file and selection as
the check boxes say."
  [p text]
  (wb/show-right! (:w p))
  (send! p text))

(defn problem-prompt
  "What Fix asks of a problem (a map of :file :line :column :message :source)."
  [p problem]
  (let [f (wb/folder (:w p))
        path (:file problem)
        rel (if (and f (string/starts-with? path (str f "/"))) (subs path (inc (count f))) path)]
    (str "Fix this problem in " rel " (line " (:line problem) ", column "
         (inc (or (:column problem) 0)) "): " (:message problem)
         (case (:source problem)
           :read "\nSkein's reader reported it."
           :compile "\nThe compiler reported it."
           "")
         "\nUse skein_eval to check the fix where it applies.")))

(defn error-prompt
  "What Ask Agent asks of a debugger's event (:condition, :restarts, :frames)."
  [e]
  (let [[message type] (:condition e)]
    (str "My Skein program signaled an error and the debugger is open.\n\n"
         "Condition: " message (when type (str " [" type "]")) "\n\n"
         "Restarts:\n"
         (string/join "\n" (map-indexed (fn [i [nm desc]] (str "  " i ": " nm " — " desc))
                                        (:restarts e)))
         "\n\nBacktrace (top frames):\n"
         (string/join "\n" (map (fn [[i text]] (str "  " i ": " text)) (take 15 (:frames e))))
         "\n\nExplain the cause and suggest a fix. You can use skein_eval to look at the "
         "running program.")))

(defn fix-selected-problem!
  "Ask the agent to fix the problem selected in the Problems panel."
  [p]
  (let [w (:w p)
        i (first (:selected-indices (:problems-list w)))]
    (if-let [problem (when i (nth (wb/all-problems w) i nil))]
      (ask! p (problem-prompt p problem))
      (wb/message! w "Select a problem first"))))

(defn ask-about-error!
  "Ask the agent about the error the debugger shows."
  [p]
  (let [w (:w p)]
    (if-let [e (debugger/current (:debugger w))]
      (ask! p (error-prompt e))
      (wb/message! w "No error in the debugger"))))

(defn install!
  "Make the agent panel of the workbench w, put it on the right of the editors and give
the workbench its commands. Returns the panel."
  ([w] (install! w {}))
  ([w opts]
   (let [p (make-panel w opts)]
     (wb/set-right-panel! w (:widget p))
     (wb/add-commands!
      w [{:menu "View" :separator true}
         {:menu "View" :title "Agent" :shortcut "Primary+J" :run (fn [] (toggle! p))}
         {:menu "Agent" :title "Explain This Code" :run (fn [] (ask! p (:explain prompts)))}
         {:menu "Agent" :title "Improve This Code" :run (fn [] (ask! p (:improve prompts)))}
         {:menu "Agent" :title "Write Tests for This"
          :run (fn [] (ask! p (:write-tests prompts)))}
         {:menu "Agent" :separator true}
         {:menu "Agent" :title "Fix Problems in This File"
          :run (fn [] (ask! p (:fix-problems prompts)))}
         {:menu "Agent" :title "Fix the Selected Problem" :run (fn [] (fix-selected-problem! p))}
         {:menu "Agent" :title "Ask About the Error" :run (fn [] (ask-about-error! p))}
         {:menu "Agent" :separator true}
         {:menu "Agent" :title "New Chat" :run (fn [] (new-chat! p))}])
     ;; right-clicking a problem or the debugger asks the agent from there
     (set-slot! (:problems-list w) :context-menu
                (ui/menu {} (ui/menu-item {:label "Ask the Agent to Fix"
                                           :on-activate (fn [_] (fix-selected-problem! p))})))
     (let [m (fn [] (ui/menu {} (ui/menu-item {:label "Ask the Agent About This Error"
                                               :on-activate (fn [_] (ask-about-error! p))})))]
       (set-slot! (:frames (:debugger w)) :context-menu (m))
       (set-slot! (:restarts (:debugger w)) :context-menu (m)))
     (ui/on (:window w) :closed (fn [_] (stop-agents! p)))
     p)))
