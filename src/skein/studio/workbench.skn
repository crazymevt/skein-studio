(ns skein.studio.workbench
  "The window (Skein's D-109): the explorer beside tabs of editors, a status bar and the
menus. A workbench is a map of the window's widgets and an atom of its state; the
commands here are what its menus do, and what tests call.

  ┌──────────────┬──────────────────────────────────────────────┐
  │ explorer     │ editor tabs                                  │
  │ (the folder) │                                              │
  ├──────────────┴──────────────────────────────────────────────┤
  │ status: message ─────────────────────── Ln, Col · language │
  └─────────────────────────────────────────────────────────────┘"
  (:require [skein.ui :as ui]
            [skein.io :as io]
            [skein.string :as string]
            [skein.studio.settings :as settings]
            [skein.studio.themes :as themes]
            [skein.studio.documents :as docs]
            [skein.studio.explorer :as explorer]
            [skein.studio.lang :as lang]
            [skein.studio.lang.skein]
            [skein.studio.editor :as editor]
            [skein.studio.highlight :as highlight]
            [skein.studio.lang.skein :as sk]
            [skein.studio.inferior :as inferior]
            [skein.studio.repl :as repl]
            [skein.studio.debugger :as debugger]
            [skein.studio.inspector :as inspector]
            [skein.studio.problems :as problems]
            [skein.studio.palette :as palette]
            [skein.studio.search :as search]
            [skein.swank.client :as swank]))

;;; State

(defn- state [wb] @(:state wb))

(defn later!
  "Call f on the UI's thread seconds from now (0: as soon as it can), unless the backend
the workbench was made with is no longer the one in use: its widgets belong to that
backend, and a test may have gone on to another. Returns the timer, or nil."
  [wb seconds f]
  (when (identical? (:backend wb) (ui/current-backend))
    (ui/after seconds f)))

(defn folder
  "The workbench's folder, or nil."
  [wb]
  (:folder (state wb)))

(defn panes
  "The panes of editor tabs, left to right: one, or two when split."
  [wb]
  (:panes (state wb)))

(defn active-pane
  "The pane of tabs the user last worked in."
  [wb]
  (or (:active-pane (state wb)) (first (panes wb))))

(defn editors
  "The open editors, pane by pane in tab order: {:document :view}. A document open in two
panes has an editor (a view) in each."
  [wb]
  (let [by-view (:editors (state wb))]
    (vec (keep (fn [page] (get by-view page)) (mapcat :children (panes wb))))))

(defn active-editor
  "The editor whose tab shows in the active pane, or nil."
  [wb]
  (when-let [page (ui/selected-page (active-pane wb))]
    (get (:editors (state wb)) page)))

(defn- activate-pane! [wb pane]
  (swap! (:state wb) assoc :active-pane pane))

(defn current-theme [] (themes/find-theme (settings/setting :theme)))

(defn- editor-font []
  {:family (or (settings/setting :font-family) :monospace) :size (settings/setting :font-size)
   :weight :regular :italic false})

;;; The title and status bar

(defn- tab-label [ed]
  (str (docs/document-name (:document ed)) (if (docs/modified? (:document ed)) " ●" "")))

(defn refresh-title!
  "Show the active document, whether it has unsaved changes, and the folder in the
window's title."
  [wb]
  (let [ed (active-editor wb)
        f (folder wb)]
    (set-slot! (:window wb) :title
               (string/join " — " (remove nil? [(when ed (tab-label ed))
                                                (when f (io/file-name f))
                                                "Skein Studio"])))))

(defn refresh-position!
  "Show where the caret is in the status bar."
  [wb]
  (set-slot! (:position wb) :text
             (if-let [ed (active-editor wb)]
               (let [v (:view ed)
                     b (:buffer v)
                     p (:cursor v)
                     n (abs (- (:anchor v) p))]
                 (str "Ln " (inc (ui/position-line b p)) ", Col " (inc (ui/position-column b p))
                      (if (pos? n) (str " (" n " selected)") "")))
               "")))

(defn message!
  "Show text in the status bar."
  [wb text]
  (set-slot! (:message wb) :text (str text)))

;;; The session: the folder, the open files and the window's size, saved soon after they
;;; change.

(defn session
  "What the workbench would restore: {:folder :files :active :size}."
  [wb]
  {:folder (folder wb)
   :files (vec (distinct (map (fn [ed] (:path (:document ed))) (editors wb))))
   :active (when-let [ed (active-editor wb)] (:path (:document ed)))
   :size [(:width (:window wb)) (:height (:window wb))]})

(defn save-session!
  "Save the session now."
  [wb]
  (when-let [t (:session-timer (state wb))] (ui/stop-timer! t))
  (swap! (:state wb) dissoc :session-timer)
  (settings/save-session! (session wb)))

(defn- schedule-session-save! [wb]
  (when-not (:session-timer (state wb))
    (swap! (:state wb) assoc :session-timer
           (later! wb 0.5 (fn [] (swap! (:state wb) dissoc :session-timer)
                           (settings/save-session! (session wb)))))))

;;; Editors

(def ^:private install-assists!
  "Give an editor the program's help while typing (defined with the program, below).")

(defn- refresh-editor! [wb ed]
  (set-slot! (:view ed) :tab-label (tab-label ed))
  (when (identical? ed (active-editor wb)) (refresh-title! wb)))

(defn- style-view! [v]
  (let [theme (current-theme)]
    (set-slot! v :palette (themes/editor-palette theme))
    (set-slot! v :text-styles (themes/text-styles theme))
    (set-slot! v :font (editor-font))
    (set-slot! v :tab-width (settings/setting :tab-width))
    (set-slot! v :line-numbers (settings/setting :line-numbers))
    (set-slot! v :wrap (settings/setting :wrap))))

(defn editor-for
  "An open editor of the file at path, in the active pane if it has one, or nil."
  [wb path]
  (let [eds (filter (fn [ed] (= path (:path (:document ed)))) (editors wb))]
    (or (first (filter (fn [ed] (identical? (active-pane wb) (:parent (:view ed)))) eds))
        (first eds))))

(defn- pane-of [ed] (:parent (:view ed)))

(defn show-editor!
  "Show the editor's tab, in its pane, and make that pane the active one."
  [wb ed]
  (activate-pane! wb (pane-of ed))
  (ui/select-page! (pane-of ed) (:view ed))
  ed)

(defn- open-view!
  "A new editor of the document d in pane, shown."
  [wb d pane]
  (let [path (:path d)
        l (lang/language-for path)
          v (editor/make-view (:buffer d) l {:tab-label (docs/document-name d)
                                            :tab-tooltip path})
          ed {:document d :view v}]
      (style-view! v)
      (when (seq (:extensions l))
        (set-slot! v :highlighter
                   (highlight/highlighter v l (fn [] (themes/color (current-theme) :match)))))
      (install-assists! wb ed)
      (swap! (:state wb) assoc-in [:editors v] ed)
      (ui/on (:buffer d) :changed (fn [_] (refresh-editor! wb ed)))
      (ui/on v :selection-changed (fn [_] (activate-pane! wb (pane-of ed)) (refresh-position! wb)))
      (ui/add! pane v)
      (show-editor! wb ed)
      (refresh-title! wb)
      (refresh-position! wb)
      (schedule-session-save! wb)
      ed))

(defn open-file!
  "Show the file at path in an editor of the active pane: its tab if it has one, else a
new one, of the document another pane has open if one does. Returns the editor."
  [wb path]
  (let [here (first (filter (fn [ed] (and (= path (:path (:document ed)))
                                          (identical? (active-pane wb) (pane-of ed))))
                            (editors wb)))]
    (if here
      (show-editor! wb here)
      (open-view! wb (or (:document (editor-for wb path)) (docs/open-document path))
                  (active-pane wb)))))

(defn save-editor!
  "Save the editor's document. Returns the editor."
  [wb ed]
  (docs/save! (:document ed))
  (refresh-editor! wb ed)
  (message! wb (str "Saved " (docs/document-name (:document ed))))
  ed)

(defn save-active!
  "Save the active editor's document."
  [wb]
  (when-let [ed (active-editor wb)] (save-editor! wb ed)))

(defn save-all!
  "Save every document with unsaved changes."
  [wb]
  (doseq [ed (editors wb)]
    (when (docs/modified? (:document ed)) (save-editor! wb ed))))

(defn- other-views? [wb ed]
  (some (fn [x] (and (identical? (:document x) (:document ed)) (not (identical? x ed))))
        (editors wb)))

(def ^:private ask-to-save?)

(defn- may-close?
  "Ask, if the editor has unsaved changes and is its document's last, whether to save
them: true to go on closing (saved or discarded), false to keep it open."
  [wb ed]
  (or (not (docs/modified? (:document ed))) (other-views? wb ed) (ask-to-save? wb ed)))

(defn- ask-to-save?
  "Ask whether to save the editor's document's changes: true to go on (saved or
discarded), false to stop."
  [wb ed]
  (case (ui/message-box (str "Save the changes to " (docs/document-name (:document ed)) "?")
                          {:detail "They are lost if you don't save them."
                           :type :warning :buttons :save-discard-cancel :parent (:window wb)})
    :save (do (save-editor! wb ed) true)
    :discard true
    false))

(defn- forget-editor! [wb ed]
  (swap! (:state wb) update :editors dissoc (:view ed))
  (refresh-title! wb)
  (refresh-position! wb)
  (schedule-session-save! wb))

(defn close-editor!
  "Close the editor's tab, asking first about unsaved changes (as its close button does).
Returns true if it closed."
  [wb ed]
  (boolean (ui/close-page! (pane-of ed) (:view ed))))

(defn close-active!
  "Close the active editor."
  [wb]
  (when-let [ed (active-editor wb)] (close-editor! wb ed)))

(defn may-quit?
  "Ask about every document with unsaved changes; true if the window may close."
  [wb]
  ;; One editor of each document, so a document open in two panes is asked about once.
  (every? (fn [[d eds]] (or (not (docs/modified? d)) (ask-to-save? wb (first eds))))
          (group-by :document (editors wb))))

;;; Files changed on disk: an editor without unsaved changes reads its file again; one with
;;; them says so in the status bar.

(defn file-changed!
  "The file at path changed on disk: refresh its editor, if it has one, and the explorer."
  [wb path]
  (when-let [ed (editor-for wb path)]
    (let [d (:document ed)]
      (when (and (io/file-exists? path) (docs/changed-on-disk? d))
        (if (docs/modified? d)
          (message! wb (str (docs/document-name d) " changed on disk; it has unsaved changes"))
          (do (docs/reload! d)
              (refresh-editor! wb ed)
              (message! wb (str "Reloaded " (docs/document-name d))))))))
  (when-let [t (:tree wb)]
    (let [dir (io/parent path)]
      (if (and dir (ui/expanded? t dir)) (ui/refresh-tree! t dir) (ui/refresh-tree! t)))))

(defn- stop-watching! [wb]
  (when-let [w (:watcher (state wb))]
    (io/stop-watch! w)
    (swap! (:state wb) dissoc :watcher)))

(defn- watch-folder! [wb root]
  (stop-watching! wb)
  (let [w (io/watch root)]
    (swap! (:state wb) assoc :watcher w)
    (future
      (loop []
        (when-let [e (<! (:events w))]
          ;; On the UI's thread, in turn with its events.
          (later! wb 0 (fn [] (file-changed! wb (:path e))))
          (recur))))))

;;; The folder

(defn open-folder!
  "Show the folder at root in the explorer, and watch it."
  [wb root]
  (let [root (io/absolute-path root)
        ex (explorer/make-explorer root)
        t (:tree wb)]
    (swap! (:state wb) assoc :folder root :explorer ex)
    (set-slot! t :children-fn (fn [p] (explorer/children ex p)))
    (set-slot! t :roots (explorer/children ex root))
    (watch-folder! wb root)
    (refresh-title! wb)
    (schedule-session-save! wb)
    root))

(defn choose-folder!
  "Ask for a folder and open it."
  [wb]
  (when-let [dir (ui/choose-directory {:title "Open Folder" :parent (:window wb)})]
    (open-folder! wb dir)))

(defn choose-file!
  "Ask for a file and open it."
  [wb]
  (when-let [f (ui/choose-file {:title "Open File" :parent (:window wb)
                                :directory (folder wb)})]
    (open-file! wb f)))

;;; Themes

(defn apply-theme!
  "Use the theme with id, and remember it."
  [wb id]
  (settings/set-setting! :theme id)
  (let [theme (current-theme)]
    (set-slot! (:window wb) :appearance (:appearance theme))
    (set-slot! (:window wb) :palette (themes/widget-palette theme))
    (doseq [ed (editors wb)] (style-view! (:view ed)))))

;;; Running the program: skein dev for the folder's project (or the active Skein file),
;;; its output in the Output panel, and its REPL in the REPL panel, all through Swank.

(defn inferior
  "The program the workbench talks to, or nil."
  [wb]
  (:inferior (state wb)))

(defn connected?
  "True while the workbench talks to a program."
  [wb]
  (inferior/alive? (inferior wb)))

(defn- async!
  "Run f on a fiber, then call done with {:value v} or {:error e} on the UI's thread."
  [wb f done]
  (future (let [r (try {:value (f)} (catch error e {:error e}))]
            (later! wb 0 (fn [] (done r))))))

(defn- reason [e] (or (ex-message e) (str e)))

(defn- on-ui
  "Call (f wb x) on the UI's thread, in turn with its events."
  [wb f x]
  (later! wb 0 (fn [] (f wb x))))

(defn append-output!
  "Add text to the Output panel."
  [wb text]
  (let [v (:output wb)
        b (:buffer v)]
    (ui/insert-into-buffer! b (ui/buffer-length b) text)
    (ui/scroll-to-position! v (ui/buffer-length b))))

(defn show-panel!
  "Show the panel page in the panels below the editors."
  [wb page]
  (let [n (:panels wb)
        i (first (keep-indexed (fn [i c] (when (identical? c page) i)) (:children n)))]
    (when i (set-slot! n :selected-index i))))

(def ^:private goto-location!
  "Show a Swank location in an editor (defined below).")

(defn handle-swank-event!
  "Act on an event from the program's Swank."
  [wb e]
  (case (:event e)
    :output (repl/append! (:repl wb) (:text e))
    :new-package (repl/set-prompt! (:repl wb) (str (:prompt e) "=> "))
    ;; Only one the user didn't ask for: Stop Program has forgotten the program already.
    :disconnected (when (inferior wb)
                    (swap! (:state wb) dissoc :inferior)
                    (message! wb (str "The program's Swank disconnected: " (:reason e))))
    :debug (do (debugger/debug! (:debugger wb) e)
               (show-panel! wb (:widget (:debugger wb)))
               (message! wb (str "Error: " (first (:condition e)))))
    :debug-activate (show-panel! wb (:widget (:debugger wb)))
    :debug-return (debugger/debug-return! (:debugger wb) e)
    nil))

(defn stop-program!
  "Stop talking to the program, and stop it if the workbench started it."
  [wb]
  (when-let [inf (inferior wb)]
    (swap! (:state wb) dissoc :inferior)
    (inferior/stop! inf)
    (message! wb "Stopped")))

(defn- running! [wb inf what]
  (swap! (:state wb) assoc :inferior inf)
  (repl/set-prompt! (:repl wb) (str @(:package (:conn inf)) "=> "))
  (message! wb what)
  ;; what was typed at the REPL while it started
  (let [[old _] (swap-vals! (:state wb) dissoc :repl-pending)]
    (doseq [text (:repl-pending old)]
      (swank/listener-eval (:conn inf) text))))

(defn- start-inferior!
  "Stop the program running, if one is, and run main under skein dev in folder, connecting
to it; label names it in the status bar."
  [wb folder main label]
  (stop-program! wb)
  (swap! (:state wb) assoc :starting true)
  (message! wb (str "Starting " label " under skein dev…"))
  (async! wb (fn [] (inferior/start! folder main
                                     (fn [line] (on-ui wb append-output! (str line "\n")))
                                     (fn [e] (on-ui wb handle-swank-event! e))))
          (fn [r]
            (swap! (:state wb) dissoc :starting)
            (if-let [inf (:value r)]
              (running! wb inf (str "Running " label))
              (do (swap! (:state wb) dissoc :repl-pending)
                  (message! wb (str "Couldn't run " label ": " (reason (:error r)))))))))

(defn run-program!
  "Run the folder's project under skein dev (its project.skn's :main), or the active
Skein file, and connect to it."
  [wb]
  (let [f (folder wb)
        active (when-let [ed (active-editor wb)] (:path (:document ed)))
        main (or (when f (inferior/project-main f))
                 (when (and active (= "skn" (io/extension active))) active))]
    (if-not main
      (message! wb "Nothing to run: no project.skn with a :main, and no Skein file open")
      (start-inferior! wb (or f (io/parent main)) main (io/file-name main)))))

(defn start-repl!
  "Start a REPL with no program: skein dev on a file of its own, (ns user), in the open
folder's project if it has one (in its .skein-cache, so the project's namespaces can be
required), else in a temporary folder."
  [wb]
  (let [f (folder wb)
        dir (if (and f (io/file? (io/path f "project.skn")))
              (io/path f ".skein-cache" "repl")
              (io/temp-dir "studio-repl"))
        main (io/path dir "user.skn")]
    (io/make-dirs dir)
    (io/write-file main "(ns user)\n")
    (start-inferior! wb (or f dir) main "the REPL")))

(defn connect-swank!
  "Ask for a host:port and connect to the Swank server there."
  [wb]
  (when-let [answer (ui/prompt-text "Connect to Swank at host:port"
                                    {:default "localhost:4005" :parent (:window wb)})]
    (let [[host port] (string/split (string/trim answer) #":")
          port (parse-long (or port ""))]
      (if-not port
        (message! wb (str "Not a host:port: " answer))
        (do (stop-program! wb)
            (async! wb (fn [] (inferior/connect! host port (fn [e] (on-ui wb handle-swank-event! e))))
                    (fn [r] (if-let [inf (:value r)]
                              (running! wb inf (str "Connected to " answer))
                              (message! wb (str "Couldn't connect to " answer ": "
                                                (reason (:error r))))))))))))

(defn file-ns
  "The namespace an editor's file declares, or nil."
  [ed]
  (second (re-find #"\(ns\s+([^\s()\[\]{}]+)" (ui/buffer-text (:buffer (:view ed))))))

(defn- request-opts [ed]
  (if-let [ns (file-ns ed)] {:package ns} {}))

(defn- with-program [wb f]
  (if (connected? wb)
    (f (:conn (inferior wb)))
    (message! wb "No program: Run ▸ Run Program starts one")))

(defn form-at-caret
  "[start end] of the top-level form at the active editor's caret, or nil."
  [wb]
  (when-let [ed (active-editor wb)]
    (when-let [hl (:highlighter (:view ed))]
      (highlight/top-level-form hl (:cursor (:view ed))))))

(def ^:private set-compile-problems!
  "Keep a compilation's notes as the file's compile problems (defined with problems).")

(defn eval-form!
  "Evaluate the top-level form at the caret in the program, and show its value."
  [wb]
  (with-program wb
    (fn [conn]
      (when-let [[s e] (form-at-caret wb)]
        (let [ed (active-editor wb)
              text (ui/buffer-text (:buffer (:view ed)) s e)]
          (message! wb "Evaluating…")
          (async! wb (fn [] (swank/call (swank/interactive-eval conn text (request-opts ed)) 120))
                  (fn [r] (message! wb (if (contains? r :value) (str (:value r))
                                           (reason (:error r)))))))))))

(defn- compile-result-message [r what]
  (if-let [v (:value r)]
    (let [[_ notes success] (when (sequential? v) (vec v))]
      (str what (if (= false success) " failed" "")
           (if (seq notes) (str " (" (count notes) " notes)") "")))
    (reason (:error r))))

(defn compile-form!
  "Compile the top-level form at the caret in the program."
  [wb]
  (with-program wb
    (fn [conn]
      (when-let [[s e] (form-at-caret wb)]
        (let [ed (active-editor wb)
              b (:buffer (:view ed))
              line (ui/position-line b s)
              text (ui/buffer-text b s e)]
          (async! wb (fn [] (swank/call (swank/compile-string
                                      conn text (docs/document-name (:document ed))
                                      (:path (:document ed)) line (ui/position-column b s)
                                      (request-opts ed))
                                     120))
                  (fn [r] (set-compile-problems! wb (:path (:document ed)) r)
                    (message! wb (compile-result-message r "Compiled the form")))))))))

(defn eval-file!
  "Save the active file and load it into the program."
  [wb]
  (with-program wb
    (fn [conn]
      (when-let [ed (active-editor wb)]
        (save-editor! wb ed)
        (let [path (:path (:document ed))]
          (async! wb (fn [] (swank/call (swank/load-file conn path) 120))
                  (fn [r] (message! wb (if (contains? r :value)
                                         (str "Loaded " (io/file-name path))
                                         (reason (:error r)))))))))))

(defn compile-file!
  "Save the active file and compile it into the program."
  [wb]
  (with-program wb
    (fn [conn]
      (when-let [ed (active-editor wb)]
        (save-editor! wb ed)
        (let [path (:path (:document ed))]
          (async! wb (fn [] (swank/call (swank/compile-file conn path) 120))
                  (fn [r] (set-compile-problems! wb path r)
                    (message! wb (compile-result-message
                                  r (str "Compiled " (io/file-name path)))))))))))

;;; The debugger, the inspector and definitions

(defn- location-position
  "The position in the text buffer b of a line (from 1) and column (from 0)."
  [b line column]
  (let [l (max 0 (min (dec (ui/buffer-line-count b)) (dec line)))]
    (min (+ (ui/line-start b l) (max 0 column)) (ui/line-end b l))))

(defn goto-location!
  "Show a Swank location, (:location (:file f) (:line l c) ...), in its editor, with the
caret there. Returns the editor, or nil."
  [wb loc]
  (let [at (problems/parse-location loc)
        ed (cond (nil? at) nil
                 (:file at) (when (io/file? (:file at)) (open-file! wb (:file at)))
                 (:buffer at) (first (filter (fn [ed] (= (:buffer at)
                                                         (docs/document-name (:document ed))))
                                             (editors wb))))]
    (if-not ed
      (message! wb (str "No source to show: " (if (and (sequential? loc) (= :error (first loc)))
                                                (second loc)
                                                (pr-str loc))))
      (let [v (:view ed)
            p (location-position (:buffer v) (:line at) (:column at))]
        (show-editor! wb ed)
        (ui/set-cursor! v p)
        (ui/scroll-to-position! v p)
        (ui/focus! v)
        ed))))

(defn- request!
  "If there is a program, call (f conn) on a fiber, then (done r) on the UI's thread with
{:value v} or {:error e}."
  [wb f done]
  (with-program wb (fn [conn] (async! wb (fn [] (f conn)) done))))

(defn- debugger-actions [wb]
  {:restart (fn [thread level i]
              (request! wb (fn [conn]
                             (swank/call (swank/invoke-nth-restart conn thread level i) 60))
                        (fn [r] nil)))
   :show-frame (fn [thread i]
                 (request! wb (fn [conn]
                                (swank/call (swank/frame-source-location conn thread i) 10))
                           (fn [r] (if (contains? r :value)
                                     (goto-location! wb (:value r))
                                     (message! wb (reason (:error r)))))))
   :eval (fn [thread i text]
           (request! wb (fn [conn] (swank/call (swank/eval-in-frame conn thread i text nil) 60))
                     (fn [r] (debugger/show-result! (:debugger wb)
                                                    (if (contains? r :value)
                                                      (str (:value r))
                                                      (reason (:error r)))))))})

(defn- show-inspected! [wb r]
  (if (contains? r :value)
    (when-let [reply (:value r)]
      (inspector/show! (:inspector wb) reply)
      (show-panel! wb (:widget (:inspector wb))))
    (message! wb (reason (:error r)))))

(defn- inspector-actions [wb]
  {:part (fn [i] (request! wb (fn [conn] (swank/call (swank/inspect-part conn i) 30))
                           (fn [r] (show-inspected! wb r))))
   :back (fn [] (request! wb (fn [conn] (swank/call (swank/inspector-pop conn) 30))
                          (fn [r] (show-inspected! wb r))))})

(defn inspect-form!
  "Inspect the value of the selection, or of the top-level form at the caret."
  [wb]
  (with-program wb
    (fn [conn]
      (when-let [ed (active-editor wb)]
        (let [v (:view ed)
              [s e] (if (ui/selection-empty? v) (form-at-caret wb) (ui/selection v))]
          (when s
            (async! wb (fn [] (swank/call (swank/inspect conn (ui/buffer-text (:buffer v) s e)
                                                      (request-opts ed))
                                       60))
                    (fn [r] (show-inspected! wb r)))))))))

(defn symbol-at-caret
  "The symbol the active editor's caret is in or just after, or nil."
  [wb]
  (when-let [ed (active-editor wb)]
    (let [v (:view ed)
          text (ui/code-text v)
          word? (fn [c] (not (contains? (set " \t\n()[]{}\"'`,;@^~") c)))
          p (:cursor v)
          start (loop [i p] (if (and (pos? i) (word? (nth text (dec i)))) (recur (dec i)) i))
          end (loop [i p] (if (and (< i (count text)) (word? (nth text i))) (recur (inc i)) i))]
      (when (< start end) (subs text start end)))))

(defn goto-definition!
  "Show where the symbol at the caret is defined, as the program knows it."
  [wb]
  (with-program wb
    (fn [conn]
      (if-let [nm (symbol-at-caret wb)]
        (let [ed (active-editor wb)]
          (async! wb (fn [] (swank/call (swank/find-definitions conn nm (request-opts ed)) 10))
                  (fn [r] (let [[[_ loc]] (when (sequential? (:value r)) (vec (:value r)))]
                            (if loc
                              (goto-location! wb loc)
                              (message! wb (str "No definition of " nm " found")))))))
        (message! wb "No symbol at the caret")))))

;;; Problems: read errors, found by reading a Skein file soon after it changes, and the
;;; compiler's notes; listed in the Problems panel and underlined in the editors.

(defn all-problems
  "Every problem known, by file and line."
  [wb]
  (vec (sort-by (fn [p] [(:file p) (:line p) (:column p)])
                (mapcat (fn [[_ by-source]] (mapcat val by-source)) (:problems (state wb))))))

(defn- problem-range [ed p]
  (let [v (:view ed)
        b (:buffer v)
        start (location-position b (:line p) (:column p))
        token (when-let [hl (:highlighter v)]
                (first (filter (fn [[s e]] (and (<= s start) (< start e)))
                               (highlight/tokens-of hl (ui/position-line b start)))))]
    [start (if token (second token) (min (ui/buffer-length b) (inc start)))]))

(defn refresh-problems!
  "Show the problems in the Problems panel and the editors."
  [wb]
  (let [ps (all-problems wb)]
    (swap! (:state wb) assoc :problem-list ps)
    (set-slot! (:problems-list wb) :items (mapv (fn [p] (problems/describe p io/file-name)) ps))
    (doseq [ed (editors wb)]
      (when-let [hl (:highlighter (:view ed))]
        (highlight/set-problems! hl (mapv (fn [p] (problem-range ed p))
                                          (filter (fn [p] (= (:file p) (:path (:document ed))))
                                                  ps)))))))

(defn- set-problems-of! [wb path source ps]
  (swap! (:state wb) assoc-in [:problems path source] (vec ps))
  (refresh-problems! wb))

(defn set-compile-problems! [wb path r]
  (set-problems-of! wb path :compile (when (contains? r :value)
                                       (problems/compile-problems (:value r) path))))

(defn check-reading!
  "Read the editor's Skein text, soon, for read errors."
  [wb ed]
  (let [path (:path (:document ed))]
    (when (= "skn" (io/extension path))
      (let [text (ui/buffer-text (:buffer (:view ed)))]
        (async! wb (fn [] (problems/read-problems path text))
                (fn [r] (when (and (contains? r :value) (editor-for wb path))
                          (set-problems-of! wb path :read (:value r)))))))))

;;; Help while typing, from the program: the argument list of the form the caret is in,
;;; in the status bar, and completions of the symbol being typed.

(defn- symbol-before [v]
  (let [text (ui/code-text v)
        end (:cursor v)
        start (loop [i end]
                (if (and (pos? i) (not (contains? (set " \t\n()[]{}\"'`,;@^~") (nth text (dec i)))))
                  (recur (dec i))
                  i))]
    [start (subs text start end)]))

(defn show-arglist!
  "Show the argument list of the form at the active editor's caret, from the program."
  [wb]
  (if-let [ed (and (connected? wb) (active-editor wb))]
    (let [v (:view ed)
          b (:buffer v)
          start (or (first (form-at-caret wb)) (ui/line-start b (ui/position-line b (:cursor v))))
          head (when (<= start (:cursor v))
                 (sk/enclosing-head (string/split (ui/buffer-text b start (:cursor v)) #"\n" -1)))
          conn (:conn (inferior wb))]
      (if-not head
        (set-slot! (:hint wb) :text "")
        (async! wb (fn [] (swank/call (swank/operator-arglist conn head (request-opts ed)) 5))
                (fn [r] (set-slot! (:hint wb) :text (if (string? (:value r)) (:value r) ""))))))
    (set-slot! (:hint wb) :text "")))

(defn- schedule! [wb key seconds f]
  (when-let [t (get-in (state wb) [:timers key])] (ui/stop-timer! t))
  (swap! (:state wb) assoc-in [:timers key]
         (later! wb seconds (fn [] (swap! (:state wb) update :timers dissoc key) (f)))))

(defn offer-completions!
  "Show the program's completions of the symbol before the caret, if it is two
characters or more."
  [wb ed]
  (let [v (:view ed)
        [start prefix] (symbol-before v)]
    (when (and (connected? wb) (identical? ed (active-editor wb)) (>= (count prefix) 2)
               (ui/selection-empty? v))
      (let [conn (:conn (inferior wb))]
        (async! wb (fn [] (first (swank/call (swank/completions conn prefix (request-opts ed)) 5)))
                (fn [r] (let [names (vec (remove (fn [n] (= n prefix)) (or (:value r) [])))]
                          (when (and (seq names) (= [start prefix] (symbol-before v)))
                            (swap! (:state wb) assoc :completing [ed start])
                            (ui/show-completion-popup! (:popup wb) v {:items names})))))))))

(defn- install-assists! [wb ed]
  (let [v (:view ed)]
    (set-slot! v :completion (:popup wb))
    (ui/on v :selection-changed (fn [_] (schedule! wb :arglist 0.3 (fn [] (show-arglist! wb)))))
    (ui/on (:buffer v) :changed
           (fn [e]
             (schedule! wb [:read (:path (:document ed))] 0.5 (fn [] (check-reading! wb ed)))
             (when (and (pos? (count (:inserted-text e))) (not (:accepting (state wb))))
               (schedule! wb :complete 0.25 (fn [] (offer-completions! wb ed))))))
    (check-reading! wb ed)))

;;; Panes of tabs: one, or two side by side when split. A pane closes with its last tab,
;;; the first excepted.

(defn- install-pane!
  "Make pane one of the workbench's panes of editor tabs."
  [wb pane]
  (swap! (:state wb) update :panes conj pane)
  ;; Closing a tab asks about unsaved changes first; a closed one is forgotten.
  (ui/on pane :page-close-request
         (fn [e]
           (when-let [ed (get (:editors (state wb)) (:value e))]
             (when-not (may-close? wb ed) (ui/veto e)))))
  (ui/on pane :page-closed
         (fn [e]
           (when-let [ed (get (:editors (state wb)) (:value e))]
             (forget-editor! wb ed))
           (when (and (empty? (:children pane)) (not (identical? pane (first (panes wb)))))
             (swap! (:state wb)
                    (fn [st] (assoc st
                                    :panes (filterv (fn [p] (not (identical? p pane))) (:panes st))
                                    :active-pane (first (:panes st)))))
             (ui/remove! (:editor-area wb) pane)
             (ui/destroy! pane)
             (refresh-title! wb))))
  (ui/on pane :page-changed (fn [_] (activate-pane! wb pane) (refresh-title! wb)
                              (refresh-position! wb) (schedule-session-save! wb)))
  pane)

(defn split-editor!
  "Show the active document in a second pane beside the first too, or, already split,
in the other pane."
  [wb]
  (when-let [ed (active-editor wb)]
    (let [others (filter (fn [p] (not (identical? p (pane-of ed)))) (panes wb))
          pane (or (first others)
                   (let [p (ui/tabbed-pane {:vexpand true :hexpand true})]
                     (ui/add! (:editor-area wb) p)
                     (install-pane! wb p)))]
      (activate-pane! wb pane)
      (open-file! wb (:path (:document ed))))))

;;; Going to a line, a file or a symbol

(defn goto-line!
  "Put the active editor's caret at the start of line (from 1)."
  [wb line]
  (when-let [ed (active-editor wb)]
    (let [v (:view ed)
          p (location-position (:buffer v) line 0)]
      (ui/set-cursor! v p)
      (ui/scroll-to-position! v p)
      (ui/focus! v))))

(defn ask-goto-line!
  "Ask for a line number and go there."
  [wb]
  (when (active-editor wb)
    (when-let [answer (ui/prompt-text "Go to line" {:parent (:window wb)})]
      (if-let [n (parse-long (string/trim answer))]
        (goto-line! wb n)
        (message! wb (str "Not a line number: " answer))))))

(defn project-files
  "The folder's files as Git sees them, relative to it, at most 20,000."
  [wb]
  (if-let [f (folder wb)]
    (let [prefix (count (str f "/"))]
      (vec (take 20000 (map (fn [p] (subs p prefix)) (io/walk f {:dirs false})))))
    []))

(defn goto-file!
  "Choose one of the folder's files, by its path, and open it."
  [wb]
  (palette/open! (:palette wb) (active-pane wb) "Go to file"
                 (mapv (fn [rel] {:label rel :path (io/path (folder wb) rel)}) (project-files wb))
                 (fn [it] (open-file! wb (:path it)))))

(defn goto-symbol!
  "Choose one of the active Skein file's definitions and go to it."
  [wb]
  (when-let [ed (active-editor wb)]
    (let [b (:buffer (:view ed))
          lines (mapv (fn [l] (ui/line-text b l)) (range (ui/buffer-line-count b)))]
      (palette/open! (:palette wb) (active-pane wb) "Go to symbol"
                     (mapv (fn [[nm l]] {:label nm :detail (str "line " (inc l)) :line (inc l)})
                           (sk/definitions lines))
                     (fn [it] (goto-line! wb (:line it)))))))

;;; Find and replace in the active editor: the find bar above the editors.

(defn- find-options [wb]
  {:query (:text (:find-entry wb)) :regex (:checked (:find-regex wb))
   :case (:checked (:find-case wb))})

(defn find-matches
  "The find bar's matches in the active editor's text."
  [wb]
  (if-let [ed (active-editor wb)]
    (let [{:keys [query regex case]} (find-options wb)]
      (search/matches (ui/buffer-text (:buffer (:view ed))) query regex case))
    []))

(defn- show-match-count! [wb ms current]
  (set-slot! (:find-count wb) :text
             (cond (empty? (:query (find-options wb))) ""
                   (empty? ms) "No matches"
                   current (str (inc current) " of " (count ms))
                   :else (str (count ms) " matches"))))

(defn find-next!
  "Select the next match after the selection (back from it if backward), around the end."
  ([wb] (find-next! wb false))
  ([wb backward]
   (when-let [ed (active-editor wb)]
     (let [v (:view ed)
           ms (find-matches wb)
           [s e] (ui/selection v)
           i (if backward
               (or (last (keep-indexed (fn [i [ms _]] (when (< ms s) i)) ms)) (dec (count ms)))
               (or (first (keep-indexed (fn [i [ms _]] (when (>= ms e) i)) ms)) 0))]
       (if-let [[ms me] (get ms i)]
         (do (ui/set-selection! v ms me)
             (ui/scroll-to-position! v ms)
             (show-match-count! wb (find-matches wb) i))
         (show-match-count! wb ms nil))))))

(defn find!
  "Show the find bar, with the selection as what to find."
  [wb]
  (set-slot! (:find-bar wb) :visible true)
  (when-let [ed (active-editor wb)]
    (let [v (:view ed)]
      (when-not (ui/selection-empty? v)
        (let [[s e] (ui/selection v)]
          (when (= (ui/position-line (:buffer v) s) (ui/position-line (:buffer v) e))
            (set-slot! (:find-entry wb) :text (ui/selected-text v)))))))
  (ui/focus! (:find-entry wb)))

(defn hide-find! [wb]
  (set-slot! (:find-bar wb) :visible false)
  (when-let [ed (active-editor wb)] (ui/focus! (:view ed))))

(defn- replacement [wb matched]
  (let [{:keys [query regex case]} (find-options wb)
        with (:text (:replace-entry wb))]
    (if regex
      (string/replace-first matched (search/pattern query true case) with)
      with)))

(defn replace!
  "Replace the selection if it is a match, then select the next."
  [wb]
  (when-let [ed (active-editor wb)]
    (let [v (:view ed)
          sel (ui/selection v)]
      (when (some (fn [m] (= m sel)) (find-matches wb))
        (ui/replace-selection! v (replacement wb (ui/selected-text v))))
      (find-next! wb))))

(defn replace-all!
  "Replace every match in the active editor, as one change. Returns how many."
  [wb]
  (when-let [ed (active-editor wb)]
    (let [b (:buffer (:view ed))
          ms (find-matches wb)]
      (ui/with-undo-group [b]
        (doseq [[s e] (reverse ms)]
          (ui/replace-buffer-range! b s e (replacement wb (ui/buffer-text b s e)))))
      (message! wb (str "Replaced " (count ms)))
      (show-match-count! wb (find-matches wb) nil)
      (count ms))))

;;; Find in files: the Search panel.

(defn find-in-files!
  "Search the folder's files for the Search panel's query, on a fiber, and list what it
finds."
  [wb]
  (when-let [f (folder wb)]
    (let [{:keys [entry regex case results status]} (:search wb)
          query (:text entry)
          prefix (count (str f "/"))]
      (set-slot! status :text "Searching…")
      (async! wb (fn [] (search/in-files f query (:checked regex) (:checked case) 2000))
              (fn [r]
                (let [found (or (:value r) [])]
                  (swap! (:state wb) assoc :search-results found)
                  (set-slot! results :items
                             (mapv (fn [m] (str (subs (:file m) prefix) ":" (:line m) ": "
                                                (:text m)))
                                   found))
                  (set-slot! status :text
                             (if (:error r) (reason (:error r))
                                 (str (count found) (if (= 2000 (count found)) "+" "")
                                      " matches")))))))))

(defn show-search!
  "Show the Search panel, with the selection as the query."
  [wb]
  (show-panel! wb (:widget (:search wb)))
  (when-let [ed (active-editor wb)]
    (when-not (ui/selection-empty? (:view ed))
      (set-slot! (:entry (:search wb)) :text (ui/selected-text (:view ed)))))
  (ui/focus! (:entry (:search wb))))

;;; Commands: what the menus and the command palette do.

(def command-palette!
  "Choose one of the commands by its name, and run it (defined below).")

(defn commands
  "The workbench's commands, in their menus' order: {:menu :title :shortcut :run}, or
{:menu m :separator true}."
  [wb]
  (let [c (fn [menu title shortcut f] {:menu menu :title title :shortcut shortcut :run f})
        sep (fn [menu] {:menu menu :separator true})]
    (into
     [(c "File" "Open Folder…" "Primary+Shift+O" (fn [] (choose-folder! wb)))
     (c "File" "Open File…" "Primary+O" (fn [] (choose-file! wb)))
     (c "File" "Go to File…" "Primary+P" (fn [] (goto-file! wb)))
     (sep "File")
     (c "File" "Save" "Primary+S" (fn [] (save-active! wb)))
     (c "File" "Save All" "Primary+Alt+S" (fn [] (save-all! wb)))
     (sep "File")
     (c "File" "Close Tab" "Primary+W" (fn [] (close-active! wb)))
     (c "Find" "Find…" "Primary+F" (fn [] (find! wb)))
     (c "Find" "Find Next" "Primary+G" (fn [] (find-next! wb)))
     (c "Find" "Find Previous" "Primary+Shift+G" (fn [] (find-next! wb true)))
     (c "Find" "Replace All" nil (fn [] (replace-all! wb)))
     (sep "Find")
     (c "Find" "Find in Files…" "Primary+Shift+F" (fn [] (show-search! wb)))
     (sep "Find")
     (c "Find" "Go to Line…" "Primary+L" (fn [] (ask-goto-line! wb)))
     (c "Find" "Go to Symbol…" "Primary+Shift+T" (fn [] (goto-symbol! wb)))
     (c "Find" "Go to Definition" "Alt+." (fn [] (goto-definition! wb)))
     (c "Run" "Run Program" "Primary+R" (fn [] (run-program! wb)))
     (c "Run" "Start REPL" "Primary+Shift+R" (fn [] (start-repl! wb)))
     (c "Run" "Stop Program" "Primary+." (fn [] (stop-program! wb)))
     (c "Run" "Connect to Swank…" nil (fn [] (connect-swank! wb)))
     (c "Eval" "Evaluate Form" "Primary+Return" (fn [] (eval-form! wb)))
     (c "Eval" "Compile Form" "Primary+K" (fn [] (compile-form! wb)))
     (c "Eval" "Load File" "Primary+Shift+Return" (fn [] (eval-file! wb)))
     (c "Eval" "Compile File" "Primary+Shift+K" (fn [] (compile-file! wb)))
     (sep "Eval")
     (c "Eval" "Inspect Form" "Primary+I" (fn [] (inspect-form! wb)))
     (c "View" "Command Palette…" "Primary+Shift+P" (fn [] (command-palette! wb)))
     (c "View" "Split Editor" "Primary+\\" (fn [] (split-editor! wb)))
     (sep "View")
     (c "View" "Studio Dark" nil (fn [] (apply-theme! wb "studio-dark")))
     (c "View" "Studio Light" nil (fn [] (apply-theme! wb "studio-light")))]
     ;; and the ones added from outside (the agent panel's)
     (:extra-commands (state wb)))))

(def ^:private menus)

(defn add-commands!
  "Add commands ({:menu :title :shortcut :run}) to the workbench's, after its own in their
menus, as a panel made outside it does."
  [wb cs]
  (swap! (:state wb) update :extra-commands (fnil into []) cs)
  (set-slot! (:window wb) :menu-bar (menus wb)))

;;; The right side: a panel made outside the workbench (the agent's)

(defn set-right-panel!
  "Put the widget w on the right of the editors, hidden until show-right! shows it."
  [wb w]
  (let [right (:right wb)]
    (doseq [c (:children right)] (ui/remove! right c))
    (ui/add! right w)))

(defn right-shown?
  "Whether the right side shows."
  [wb]
  (boolean (:visible (:right wb))))

(defn show-right!
  "Show the right side, or with shown false hide it."
  ([wb] (show-right! wb true))
  ([wb shown] (set-slot! (:right wb) :visible (boolean shown))))

(defn command-palette!
  "Choose one of the commands by its name, and run it."
  [wb]
  (palette/open! (:palette wb) (active-pane wb) "Run a command"
                 (vec (keep (fn [c] (when-not (:separator c)
                                      {:label (str (:menu c) ": " (:title c))
                                       :detail (when (:shortcut c)
                                                 (ui/shortcut-label (:shortcut c)))
                                       :run (:run c)}))
                            (commands wb)))
                 (fn [it] ((:run it)))))

;;; Menus

(defn- menu-items [wb menu]
  (mapv (fn [c] (if (:separator c)
                  (ui/menu-separator)
                  (ui/menu-item (merge {:label (:title c) :on-activate (fn [_] ((:run c)))}
                                       (when (:shortcut c) {:shortcut (:shortcut c)})))))
        (filter (fn [c] (= menu (:menu c))) (commands wb))))

(defn- menus [wb]
  (apply ui/menu-bar {}
    (apply ui/menu {:title "File"} (conj (menu-items wb "File") (ui/menu-item {:role :quit})))
    (ui/menu {:title "Edit"}
      (ui/menu-item {:role :undo}) (ui/menu-item {:role :redo}) (ui/menu-separator)
      (ui/menu-item {:role :cut}) (ui/menu-item {:role :copy}) (ui/menu-item {:role :paste})
      (ui/menu-item {:role :select-all}))
    (apply ui/menu {:title "Find"} (menu-items wb "Find"))
    (apply ui/menu {:title "Run"} (menu-items wb "Run"))
    (apply ui/menu {:title "Eval"} (menu-items wb "Eval"))
    ;; menus only commands added from outside have (the Agent menu), before View
    (concat (for [m (distinct (map :menu (:extra-commands (state wb))))
                  :when (not (contains? #{"File" "Find" "Run" "Eval" "View"} m))]
              (apply ui/menu {:title m} (menu-items wb m)))
            [(apply ui/menu {:title "View"} (menu-items wb "View"))])))

;;; The window

(defn make-workbench
  "A workbench: its window with the explorer, the editors' tabs and a status bar, not yet
shown. opts: :size [width height]."
  ([] (make-workbench {}))
  ([opts]
   (let [theme (current-theme)
         [width height] (or (:size opts) [1100 720])
         st (atom {:editors {} :panes []})
         wb-ref (atom nil)
         tree (ui/tree-view {:roots [] :item-label io/file-name :children-fn (fn [_] [])
                             :on-row-activated (fn [e]
                                                 (let [p (:item e)]
                                                   (when (io/file? p)
                                                     (open-file! @wb-ref p))))})
         tabs (ui/tabbed-pane {:vexpand true :hexpand true})
         editor-area (ui/hbox {:vexpand true :hexpand true :spacing 1} tabs)
         ;; Fixed widths, so the options and the count keep their labels.
         find-entry (ui/entry {:placeholder "Find" :width 180})
         replace-entry (ui/entry {:placeholder "Replace with" :width 150})
         find-regex (ui/check-box {:label "Regex" :width 74})
         find-case (ui/check-box {:label "Match Case" :width 110})
         find-count (ui/label {:text "" :text-color :secondary-text :width 80})
         find-prev (ui/button {:label "Previous"})
         find-next (ui/button {:label "Next"})
         replace-one (ui/button {:label "Replace"})
         replace-every (ui/button {:label "Replace All"})
         find-close (ui/button {:label "Done"})
         find-bar (ui/hbox {:padding [4 8] :spacing 6 :visible false}
                    find-entry find-regex find-case find-prev find-next find-count
                    replace-entry replace-one replace-every find-close)
         search-entry (ui/entry {:placeholder "Find in files" :hexpand true})
         search-regex (ui/check-box {:label "Regex"})
         search-case (ui/check-box {:label "Match Case"})
         search-results (ui/list-box {:items [] :vexpand true})
         search-status (ui/label {:text "" :text-color :secondary-text})
         search-panel (ui/vbox {:padding 8 :spacing 6 :tab-label "Search"}
                        (ui/hbox {:spacing 6} search-entry search-regex search-case)
                        search-results search-status)
         pal (palette/make-palette)
         message (ui/label {:text "" :text-color :secondary-text :hexpand true})
         hint (ui/label {:text "" :text-color :secondary-text})
         position (ui/label {:text "" :text-color :secondary-text})
         output (ui/code-view {:editable false :line-numbers false :wrap true
                               :tab-label "Output"})
         repl-panel (repl/make-repl
                     (fn [text]
                       (if-let [inf (:inferior @st)]
                         (swank/listener-eval (:conn inf) text)
                         ;; no program: start a REPL (unless one is starting), then send it
                         (when-let [w @wb-ref]
                           (swap! st update :repl-pending (fnil conj []) text)
                           (when-not (:starting @st)
                             (repl/append! (:repl w) (str "; Starting a REPL (Run ▸ Start "
                                                          "REPL); Run ▸ Run Program runs the "
                                                          "project instead\n"))
                             (start-repl! w)))))
                     (fn [prefix] (if-let [inf (:inferior @st)]
                                    (first (swank/call (swank/completions (:conn inf) prefix) 5))
                                    [])))
         popup (ui/completion-popup {:max-visible-rows 10})
         ;; The panels' actions need the workbench, made after them: they find it when called.
         late (fn [actions k] (fn [& args] (apply (get (actions @wb-ref) k) args)))
         dbg (debugger/install! (debugger/make-debugger
                                 {:restart (late debugger-actions :restart)
                                  :show-frame (late debugger-actions :show-frame)
                                  :eval (late debugger-actions :eval)}))
         insp (inspector/make-inspector {:part (late inspector-actions :part)
                                         :back (late inspector-actions :back)})
         problems-list (ui/list-box {:items [] :vexpand true :tab-label "Problems"})
         ;; the right side, which a panel made outside the workbench fills (set-right-panel!)
         right (ui/vbox {:visible false :width 420 :hexpand false})
         panels (ui/notebook {} (doto (:widget repl-panel) (set-slot! :tab-label "REPL")) output
                             (doto (:widget dbg) (set-slot! :tab-label "Debugger"))
                             (doto (:widget insp) (set-slot! :tab-label "Inspector"))
                             problems-list search-panel)
         window (ui/window {:title "Skein Studio" :width width :height height
                            :appearance (:appearance theme)
                            :palette (themes/widget-palette theme)}
                  (ui/vbox {}
                    (ui/paned {:position 240 :vexpand true}
                              (ui/scrolled-window {} tree)
                              (ui/hbox {:spacing 1}
                                (ui/paned {:orientation :vertical :position (- height 300)
                                           :hexpand true}
                                          (ui/vbox {} find-bar editor-area) panels)
                                right))
                    (ui/hbox {:padding [3 10] :spacing 12 :surface :status}
                             message hint position)))
         wb {:window window :tree tree :tabs tabs :editor-area editor-area :palette pal
             :find-bar find-bar :find-entry find-entry :replace-entry replace-entry
             :find-regex find-regex :find-case find-case :find-count find-count
             :search {:widget search-panel :entry search-entry :regex search-regex
                      :case search-case :results search-results :status search-status}
             :message message :position position
             :hint hint :output output :repl repl-panel :popup popup :state st
             :debugger dbg :inspector insp :problems-list problems-list :panels panels
             :right right :backend (ui/current-backend)}]
     (reset! wb-ref wb)
     ;; The find bar
     (ui/on find-entry :changed (fn [_] (show-match-count! wb (find-matches wb) nil)))
     (ui/on find-entry :activate (fn [_] (find-next! wb)))
     (ui/on replace-entry :activate (fn [_] (replace! wb)))
     (doseq [x [find-entry replace-entry]]
       (ui/on x :key-down (fn [e] (when (= :escape (:key e)) (hide-find! wb) (ui/consume! e)))))
     (doseq [x [find-regex find-case]]
       (ui/on x :toggled (fn [_] (show-match-count! wb (find-matches wb) nil))))
     (ui/on find-prev :clicked (fn [_] (find-next! wb true)))
     (ui/on find-next :clicked (fn [_] (find-next! wb)))
     (ui/on replace-one :clicked (fn [_] (replace! wb)))
     (ui/on replace-every :clicked (fn [_] (replace-all! wb)))
     (ui/on find-close :clicked (fn [_] (hide-find! wb)))
     ;; The Search panel
     (ui/on search-entry :activate (fn [_] (find-in-files! wb)))
     (ui/on search-results :row-activated
            (fn [e] (when-let [m (get (:search-results @st) (:index e))]
                      (goto-location! wb (list :location (list :file (:file m))
                                               (list :line (:line m) (:column m)) nil)))))
     (ui/on problems-list :row-activated
            (fn [e] (when-let [p (get (:problem-list @st) (:index e))]
                      (goto-location! wb (list :location (list :file (:file p))
                                               (list :line (:line p) (:column p)) nil)))))
     ;; A completion chosen replaces the symbol being typed.
     (ui/on popup :accept
            (fn [e]
              (when-let [[ed start] (:completing @st)]
                (let [v (:view ed)]
                  (swap! st assoc :accepting true)
                  (try (ui/set-selection! v start (:cursor v))
                       (ui/replace-selection! v (:value e))
                       (finally (swap! st dissoc :accepting)))))))
     (set-slot! window :menu-bar (menus wb))
     (install-pane! wb tabs)
     (ui/on window :close-request (fn [e] (when-not (may-quit? wb) (ui/veto e))))
     (ui/on window :resize (fn [_] (schedule-session-save! wb)))
     (ui/on window :closed (fn [_] (stop-watching! wb) (stop-program! wb) (save-session! wb)
                             (ui/destroy! popup)))
     wb)))

(defn restore-session!
  "Open the saved session's folder and files, those that still exist."
  [wb s]
  (when-let [f (:folder s)]
    (when (io/directory? f) (open-folder! wb f)))
  (doseq [p (:files s)]
    (when (io/file? p) (open-file! wb p)))
  (when-let [p (:active s)]
    (when (editor-for wb p) (open-file! wb p))))
