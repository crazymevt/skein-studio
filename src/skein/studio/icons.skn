                 " M1 1l22 22")})

(defn icon
  "The image of the icon named k (a keyword of paths; :file for one it doesn't have),
:size points (16), in :color (:text, a template, by default), as vector-image takes."
  ([k] (icon k {}))
  ([k opts]
   (ui/vector-image (get paths k (:file paths)) opts)))
